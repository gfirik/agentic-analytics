# agentic-analytics — local, free defaults. No keys needed for the defaults.
PORT=8080
DATA_DIR=./data

# Models. No LLM is required to build and test: tests use FakeModel.
# For real runs, point these at Ollama (optional) or a free OpenAI-compatible endpoint such as Groq.
OLLAMA_BASE_URL=http://localhost:11434
PLANNER_MODEL=ollama:qwen3.5:9b
EXTRACTOR_MODEL=ollama:qwen3.5:9b
JUDGE_MODEL=ollama:qwen3.5:9b
EMBEDDING_MODEL=transformers:Xenova/bge-m3   # in-process, no install
MODEL_TIMEOUT_MS=300000

# Optional free hosted endpoints (OpenAI-compatible, free tiers). Use with synthetic data only.
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# SAMBANOVA_API_KEY=
# MISTRAL_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# The same model on several providers (falls back to the next when one is rate-limited; never switches models):
# PLANNER_MODEL=openai-compatible:groq:openai/gpt-oss-120b|openai-compatible:openrouter:openai/gpt-oss-120b
# Response cache for repeated runs (aa eval always caches in evals/.cache):
# AA_MODEL_CACHE=data/model-cache
# Echo every model call (provider, model, tokens) to stderr; they are always appended to data/logs/model-calls.jsonl
# AA_LOG_CALLS=1
# Example: PLANNER_MODEL=openai-compatible:groq:llama-3.3-70b-versatile
# Groq free tier (M11 smoke results, evals/RESULTS.md): openai-compatible:groq:qwen/qwen3.8-27b with --small-model was the only model to complete the smoke suite within the free quota; no model passes the v0.1 bars yet

# Optional services
SEARXNG_URL=http://localhost:8888
# Optional: SearXNG engines to use when the defaults rate-limit or show CAPTCHAs from your network (e.g. yahoo,bing)
# SEARXNG_ENGINES=yahoo
DOCLING_URL=http://localhost:5001
WEB_ENABLED=false

# Optional
# API_TOKEN=
# TELEGRAM_BOT_TOKEN=
# JOB_TTL_DAYS=
LOG_LEVEL=info
