exports[`report.html (report-schema §6) > renders the scorecard and the not-run list as in the snapshot 1`] = `"<section aria-labelledby="scorecard"><h2 id="scorecard">Scorecard · 2026-06</h2><div class="grid"><table><thead><tr><th scope="col">Metric</th><th scope="col">Value</th><th scope="col">vs baseline</th><th scope="col">Material</th><th scope="col">vs same period last year</th></tr></thead><tbody><tr><th scope="row">Revenue</th><td><button type="button" class="num" data-fact="N17" aria-haspopup="dialog" title="revenue_2026-06 — show how this was computed">37,000</button></td><td><button type="button" class="num" data-fact="N417" aria-haspopup="dialog" title="scorecard.revenue.vs_base_2026-06 — show how this was computed">1,200</button> (<button type="button" class="num" data-fact="N418" aria-haspopup="dialog" title="scorecard.revenue.vs_base_pct_2026-06 — show how this was computed">3.4%</button>)<span class="muted"> vs previous period</span></td><td>no</td><td><span class="muted">n/a: not enough history</span></td></tr><tr><th scope="row">Orders</th><td><button type="button" class="num" data-fact="N421" aria-haspopup="dialog" title="orders_2026-06 — show how this was computed">1,040</button></td><td><button type="button" class="num" data-fact="N423" aria-haspopup="dialog" title="scorecard.orders.vs_base_2026-06 — show how this was computed">35</button> (<button type="button" class="num" data-fact="N424" aria-haspopup="dialog" title="scorecard.orders.vs_base_pct_2026-06 — show how this was computed">3.5%</button>)<span class="muted"> vs previous period</span></td><td>no</td><td><span class="muted">n/a: not enough history</span></td></tr><tr><th scope="row">Units sold</th><td><button type="button" class="num" data-fact="N431" aria-haspopup="dialog" title="units_2026-06 — show how this was computed">2,118</button></td><td><button type="button" class="num" data-fact="N433" aria-haspopup="dialog" title="scorecard.units.vs_base_2026-06 — show how this was computed