exports[`report.html (report-schema §6) > renders the scorecard and the not-run list as in the snapshot 2`] = `"<section aria-labelledby="not-run"><h2 id="not-run">Analyses not run</h2><ul><li><span class="mono">gross_margin</span> — There is no cost column (unit cost or cost amount), so margin can&#x27;t be computed.<span class="muted"> Needs: unit cost, cost amount.</span></li><li><span class="mono">pvm_margin.v1</span> — There is no cost column (unit cost or cost amount), so the margin change can&#x27;t be split into price, cost, volume and mix.<span class="muted"> Needs: unit cost, cost amount.</span></li><li><span class="mono">contribution_margin</span> — There is no variable cost column, so contribution margin can&#x27;t be computed.<span class="muted"> Needs: variable cost.</span></li><li><span class="mono">pareto.v1</span> — The data doesn&#x27;t cover the year before the trailing year, so the classes can&#x27;t be compared with it.</li><li><span class="mono">yoy</span> — There is not enough history for a year-on-year comparison.</li><li><span class="mono">kpi.cancellation_rate</span> — Cancellation rate: no status column marks cancelled lines.<span class="muted"> Needs: status.</span></li><li><span class="mono">kpi.discount_rate</span> — Discount rate: there is no discount column.<span class="muted"> Needs: discount.</span></li></ul></section>"`;
