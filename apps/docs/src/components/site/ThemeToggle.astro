---
// The colour theme control, on the landing page and in the docs (it replaces Starlight's ThemeSelect). It cycles
// auto → light → dark and stores the choice under Starlight's own key (`starlight-theme`), so both halves of the
// site share it. It is hidden until its script runs: without JS the theme follows the system (tokens.css).
---

<button type="button" class="aa-theme" data-aa-theme hidden>
  <svg class="aa-theme-icon" data-icon="auto" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M8 2.25a5.75 5.75 0 0 1 0 11.5z" fill="currentColor"></path>
  </svg>
  <svg class="aa-theme-icon" data-icon="light" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M8 1v1.75M8 13.25V15M1 8h1.75M13.25 8H15M3.05 3.05l1.24 1.24M11.71 11.71l1.24 1.24M3.05 12.95l1.24-1.24M11.71 4.29l1.24-1.24"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <svg class="aa-theme-icon" data-icon="dark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
  </svg>
  <span class="aa-theme-label" data-aa-theme-label>Auto</span>
</button>

<script>
  type Theme = "auto" | "light" | "dark";
  const KEY = "starlight-theme";
  const NEXT: Record<Theme, Theme> = { auto: "light", light: "dark", dark: "auto" };
  const NAME: Record<Theme, string> = { auto: "Auto", light: "Light", dark: "Dark" };

  const load = (): Theme => {
    try {
      const v = localStorage.getItem(KEY);
      return v === "light" || v === "dark" ? v : "auto";
    } catch {
      return "auto";
    }
  };
  const resolve = (t: Theme) => (t === "auto" ? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark") : t);

  function apply(t: Theme) {
    document.documentElement.dataset.theme = resolve(t);
    try {
      localStorage.setItem(KEY, t === "auto" ? "" : t);
    } catch {
      // Storage can be blocked; the theme still applies for this page.
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-aa-theme]")) {
      b.hidden = false;
      b.dataset.current = t;
      b.setAttribute("aria-label", `Colour theme: ${NAME[t]}. Switch to ${NAME[NEXT[t]]}`);
      const label = b.querySelector("[data-aa-theme-label]");
      if (label) label.textContent = NAME[t];
    }
  }

  apply(load());
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-aa-theme]"))
    b.addEventListener("click", () => apply(NEXT[load()]));
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (load() === "auto") apply("auto");
  });
</script>

<style>
  .aa-theme {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0 0.6rem;
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
    background: transparent;
    color: var(--aa-ink-2);
    font: 500 0.8125rem/1 var(--aa-font-mono);
    cursor: pointer;
  }
  .aa-theme[hidden] {
    display: none;
  }
  .aa-theme:hover {
    border-color: var(--aa-ink);
    color: var(--aa-ink);
  }
  .aa-theme-icon {
    width: 1rem;
    height: 1rem;
    display: none;
  }
  .aa-theme[data-current="auto"] [data-icon="auto"],
  .aa-theme[data-current="light"] [data-icon="light"],
  .aa-theme[data-current="dark"] [data-icon="dark"] {
    display: block;
  }
</style>
