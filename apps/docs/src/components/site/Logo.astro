---
// The wordmark: the name alone, set in the interface sans (DESIGN.md §6). There is no icon mark; the favicon is an "aa" lettermark.
import { withBase } from "./site.ts";
---

<a href={withBase("/")} class="aa-logo">
  <span class="aa-logo-name" translate="no">agentic-analytics</span>
</a>

<style>
  .aa-logo {
    display: inline-flex;
    align-items: center;
    color: var(--aa-ink);
    text-decoration: none;
    font: 600 1rem/1 var(--aa-font-sans);
    letter-spacing: -0.01em;
    white-space: nowrap;
    min-height: 2.75rem;
  }
</style>
