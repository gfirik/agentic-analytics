---
// A bracketed section label centred on a hairline (DESIGN.md §3): ⊣ §2 HOW IT WORKS ⊢, in mono.
interface Props {
  n: number;
  text: string;
}
const { n, text } = Astro.props;
---

<p class="aa-seclabel">
  <span class="aa-seclabel-text"><span aria-hidden="true">⊣ </span>§{n} {text}<span aria-hidden="true"> ⊢</span></span>
</p>

<style>
  .aa-seclabel {
    display: flex;
    align-items: center;
    gap: var(--aa-space-4);
    width: 100%;
    margin: 0;
  }
  .aa-seclabel::before,
  .aa-seclabel::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--aa-rule);
  }
  .aa-seclabel-text {
    font: 500 var(--aa-text-label) / 1.3 var(--aa-font-mono);
    letter-spacing: var(--aa-label-tracking);
    text-transform: uppercase;
    color: var(--aa-ink-3);
    white-space: nowrap;
  }
</style>
