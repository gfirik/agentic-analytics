---
// The status strip (DESIGN.md §4): one quiet mono line above the header, not a marquee. Its items come from
// generated data (scripts/landing-data.ts statusStrip(), written into src/data/evals.json), never typed.
import { withBase } from "./site.ts";

interface Props {
  items: { text: string; href?: string; more?: string }[];
}
const { items } = Astro.props;
---

<div class="aa-strip aa-scroll-x" role="region" aria-label="Project status" tabindex="0">
  <p class="aa-strip-inner">
    {
      items.map((item, i) => (
        <>
          {i > 0 ? <span aria-hidden="true"> · </span> : null}
          {item.href ? (
            <a href={item.href.startsWith("#") ? item.href : withBase(item.href)}>
              {item.text}
              {item.more ? <span class="aa-sr">, {item.more}</span> : null}
            </a>
          ) : (
            <span>{item.text}</span>
          )}
        </>
      ))
    }
  </p>
</div>

<script>
  // The one-line scroll boxes (this strip, the hero's install line) hide their scrollbar; a fade at the edge with
  // more to read says they scroll instead (DESIGN.md §6 "Horizontal scroll boxes"). Marks which edges have more.
  for (const box of document.querySelectorAll<HTMLElement>(".aa-scroll-x")) {
    let frame = 0;
    const mark = () => {
      frame = 0;
      const more = box.scrollWidth - box.clientWidth;
      const start = box.scrollLeft > 1;
      const end = box.scrollLeft < more - 1;
      box.dataset.overflow = more <= 1 ? "none" : start && end ? "both" : start ? "start" : "end";
    };
    const soon = () => {
      if (!frame) frame = requestAnimationFrame(mark);
    };
    mark();
    box.addEventListener("scroll", soon, { passive: true });
    window.addEventListener("resize", soon);
    document.fonts?.ready.then(soon);
  }
</script>

<style>
  /* One line, as the design says: on narrow screens the strip scrolls sideways rather than wrapping, so its height
     never depends on when the mono face arrives (re-wrapping on the swap moved the page, M13k). It is a labelled,
     focusable region so a keyboard can scroll it. */
  .aa-strip {
    position: relative;
    border-bottom: 1px solid var(--aa-rule);
    background: var(--aa-surface);
    overflow-x: auto;
  }
  .aa-strip-inner {
    max-width: var(--aa-container);
    margin: 0 auto;
    padding: 0.45rem var(--aa-gutter);
    font: 400 var(--aa-text-label) / 1.5 var(--aa-font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--aa-ink-2);
    white-space: nowrap;
  }
  .aa-strip-inner a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--aa-rule-strong);
    text-underline-offset: 0.2em;
  }
  .aa-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .aa-strip-inner a:hover {
    color: var(--aa-ink);
    text-decoration-color: currentColor;
  }
</style>
