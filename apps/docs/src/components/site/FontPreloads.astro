---
// Preloads the faces the first screen paints in (Lighthouse, M13i): the serif (statements, docs prose), and on the
// landing page Plex Sans 400 (copy) and Plex Mono 400 (the status strip, labels and the install line: when it swapped
// in late, the strip re-wrapped and moved the page, M13k). The landing hero's two-voice headline (site v5 PR 1b) is
// Plex Sans 700 and the serif italic, so there those two replace the upright serif, which only paints below the fold.
// Same files as fonts.css, resolved by Vite, so the URLs carry the build's hashes. Each face also has a metric-matched
// fallback (fonts.css), so a late face moves nothing; the preloads are for how soon it looks right, not for CLS.

import mono from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import sans from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import sansHeavy from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url";
import serifItalic from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-italic.woff2?url";
import serif from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";

interface Props {
  /** The docs paint their first screen (the article) in the serif only. */
  serifOnly?: boolean;
  /** The landing page: its first screen is the hero (Plex Sans 700 and the serif italic), not the upright serif. */
  hero?: boolean;
}
const { serifOnly = false, hero = false } = Astro.props;
---

<link rel="preload" href={hero ? serifItalic : serif} as="font" type="font/woff2" crossorigin fetchpriority="high" />
{hero ? <link rel="preload" href={sansHeavy} as="font" type="font/woff2" crossorigin fetchpriority="high" /> : null}
{serifOnly ? null : <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />}
{serifOnly ? null : <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />}
