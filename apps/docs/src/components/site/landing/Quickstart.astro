---
// §4 Quickstart (DESIGN.md §5): a band. The head, then the three steps (install, model, analyze), then the
// standalone binaries with the Docker line beside the four doors (CLI, HTTP API, MCP, Telegram).
import { GITHUB_URL, RELEASES_URL, withBase } from "../site.ts";
import SectionHead from "./SectionHead.astro";

const binaries = ["aa-linux-x64", "aa-linux-arm64", "aa-macos-arm64", "aa-windows-x64.exe", "SHA256SUMS"];
const doors = [
  {
    name: "CLI",
    does: "Analyze files, ask follow-ups, open the working behind any number.",
    cmd: "aa analyze ./exports --open",
    href: "use-it/cli/",
  },
  {
    name: "HTTP API",
    does: "Upload files, stream progress over SSE, fetch the report as JSON or HTML.",
    cmd: "aa serve",
    href: "use-it/http-api/",
  },
  {
    name: "MCP",
    does: "Claude Desktop, Cursor or any MCP client analyzes files and quotes verified numbers.",
    cmd: "aa mcp",
    href: "use-it/mcp/",
  },
  {
    name: "Telegram",
    does: "A demo bot: send files, get the summary and the report back.",
    cmd: "bun run --filter @agentic-analytics/telegram start",
    href: "use-it/telegram/",
  },
];
---

<section id="quickstart" class="aa-sheet" data-reveal aria-labelledby="aa-quick-title">
  <div class="aa-cell aa-band aa-quick-row">
    <SectionHead n={4} label="Quickstart" id="aa-quick-title" title="Run it on the example, then on your files.">
      Install, pick a free model, analyze the example.
    </SectionHead>
    <ol class="aa-steps">
      <li class="aa-step">
        <p class="aa-label">Step 1 · Install</p>
        <div class="aa-code" data-copy-host>
          <pre tabindex="0" aria-label="Install"><code>git clone {GITHUB_URL}
cd agentic-analytics
bun install
bun run aa doctor</code></pre>
        </div>
        <p class="aa-small">Node 22 and Bun. <code>doctor</code> says what this machine has.</p>
      </li>
      <li class="aa-step">
        <p class="aa-label">Step 2 · Model</p>
        <div class="aa-code" data-copy-host>
          <pre tabindex="0" aria-label="Choose a model"><code><span class="c"># Ollama, or a free endpoint in .env</span>
cp .env.example .env</code></pre>
        </div>
        <p class="aa-small">
          Free and local only: Ollama or a free OpenAI-compatible endpoint. <a href={withBase("models/running-free/")}>Running free</a>
        </p>
      </li>
      <li class="aa-step">
        <p class="aa-label">Step 3 · Analyze</p>
        <div class="aa-code" data-copy-host>
          <pre tabindex="0" aria-label="Analyze the example"><code>bun run aa analyze examples/coffee-roaster --open
<span class="c"># no model yet? replay it offline</span>
AA_DEMO_MODEL=scripted bun run aa analyze examples/coffee-roaster --yes --embedder hash</code></pre>
        </div>
        <p class="aa-small">The report opens with every number linked to its working.</p>
      </li>
    </ol>
    <div class="aa-quick-bins">
      <p class="aa-label">Standalone binaries · Docker</p>
      <p class="aa-small">
        No Node or Bun needed: attached to each tagged release, from v0.1.0 on, with a checksum file. <a href={RELEASES_URL}
          >Releases</a
        >
      </p>
      <ul class="aa-binaries">{binaries.map((b) => <li><code data-copy>{b}</code></li>)}</ul>
      <p class="aa-small"><code data-copy>docker compose up</code> · API, viewer and MCP on <code data-copy>http://127.0.0.1:8080</code></p>
    </div>
    <div class="aa-quick-doors">
      <p class="aa-label">Four doors, one engine</p>
      <ul class="aa-doors">
        {
          doors.map((d) => (
            <li>
              <a class="aa-door-name" href={withBase(d.href)}>
                {d.name}
              </a>
              <span class="aa-door-does">{d.does}</span>
              <code class="aa-door-cmd" data-copy><span class="aa-scroll" tabindex="0">{d.cmd}</span></code>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* §4: a full-width band (site v5). The head across the top, the three steps side by side under it (from 56rem), then
     the binaries and the four doors side by side (from 1100px). Stacked: head, steps, binaries, doors. */
  .aa-quick-row {
    grid-template-areas: "head" "steps" "bins" "doors";
  }
  .aa-quick-row > :global(.aa-cell-head) {
    grid-area: head;
  }
  .aa-steps {
    grid-area: steps;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--aa-rule);
  }
  .aa-step {
    display: grid;
    align-content: start;
    gap: var(--aa-space-3);
    padding: var(--aa-space-6) 0;
  }
  .aa-step + .aa-step {
    border-top: 1px solid var(--aa-rule);
  }
  /* From 56rem a step is a row: its label and note on the left, its commands on the right at the band's width, so a
     long command fits on one line instead of the three steps sharing one row. */
  @media (min-width: 56rem) {
    .aa-step {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      column-gap: var(--aa-space-6);
      align-items: start;
      grid-template-rows: auto 1fr; /* the note sits under its label, not centred against the command */
    }
    .aa-step > .aa-label {
      grid-column: 1;
      grid-row: 1;
    }
    .aa-step > .aa-small {
      grid-column: 1;
      grid-row: 2;
    }
    .aa-step > .aa-code {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  /* From 80rem the binaries (a short list) and the doors (commands that need the room) share the row under the steps,
     about 1:3; below that the doors take the full width under the binaries. */
  @media (min-width: 80rem) {
    /* Two classes: these override the page's band grid (index.astro, a global rule later in the CSS). */
    .aa-band.aa-quick-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      grid-template-areas: "head head" "steps steps" "bins doors";
      column-gap: var(--aa-space-8);
    }
  }
  /* Commands are one line each; the block scrolls where the column is narrower than the command (site.css). */
  .aa-steps .aa-code pre {
    font-size: var(--aa-text-code);
  }
  .aa-quick-bins {
    grid-area: bins;
  }
  .aa-quick-doors {
    grid-area: doors;
  }
  .aa-quick-bins,
  .aa-quick-doors {
    display: grid;
    align-content: start;
    gap: var(--aa-space-3);
    min-width: 0;
  }
  .aa-binaries {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--aa-text-small);
    border-top: 1px solid var(--aa-rule-strong);
  }
  .aa-binaries li {
    padding: var(--aa-space-1) 0;
    border-bottom: 1px solid var(--aa-rule);
  }
  .aa-doors {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--aa-rule-strong);
  }
  .aa-doors li {
    display: grid;
    grid-template-columns: 6.5rem minmax(10rem, 1fr) minmax(0, 27rem);
    gap: var(--aa-space-1) var(--aa-space-4);
    align-items: baseline;
    padding: var(--aa-space-3) 0;
    border-bottom: 1px solid var(--aa-rule);
  }
  .aa-door-name {
    font-weight: 600;
  }
  .aa-door-does {
    font-size: var(--aa-text-small);
    color: var(--aa-ink-2);
  }
  /* One line; .aa-scroll inside scrolls it where the cell is narrower than the command. The button stays at the
     command's end (copy.ts puts it on the code, outside the scroller). */
  .aa-door-cmd {
    display: block;
    min-width: 0;
    justify-self: start;
    font-size: var(--aa-text-code);
    color: var(--aa-ink);
  }
  @media (max-width: 56rem) {
    .aa-doors li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* A door takes the mark wash under the pointer, in 150ms, so the eye can follow it across. */
  .aa-doors li {
    transition: background-color var(--aa-fast) var(--aa-ease);
  }
  .aa-doors li:hover {
    background-color: var(--aa-mark);
  }
</style>
