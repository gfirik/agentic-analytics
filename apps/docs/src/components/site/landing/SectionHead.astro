---
// A landing section's head (DESIGN.md §5 "Section heads"): the bracketed label, the h2 and a one-sentence lead (the
// default slot), --aa-space-4 apart. Centred when stacked; on the left from 1100px, where the label's hairline runs
// only after it. A band's head stands on graph paper (`field`); the engine machine's sits in its stage's head slot
// without it.
import SectionLabel from "../SectionLabel.astro";

interface Props {
  /** The section number; omitted for the engine machine's band, which comes before §1. */
  n?: number;
  label: string;
  /** The h2's id, which the section's aria-labelledby names. */
  id: string;
  title: string;
  /** Graph paper behind the head (every band's head; not the engine machine's). */
  field?: boolean;
  class?: string;
}
const { n, label, id, title, field = true, class: className } = Astro.props;
---

<div class:list={["aa-cell-head", className, { "aa-grid-field": field }]}>
  <SectionLabel n={n} text={label} />
  <h2 id={id} class="aa-h2 aa-center">{title}</h2>
  <p class="aa-lead aa-center"><slot /></p>
</div>

<style>
  /* Graph paper behind the section heads only (decorative; the hero has its own field), full-bleed: it runs out to
     the screen's edges and fades to the plain page through a CSS mask. It sits under the content, never behind the
     visuals or long text. Every head is a band's (site v5), so its field spans the screen's width over the head's
     height. Its width uses 50vw / 100vw, which include a classic (non-overlay) scrollbar's width,
     so the field can reach a few pixels past the viewport: .aa-paper's overflow-x: clip hides that, and the
     no-sideways-scroll browser tests hold with it. */
  .aa-grid-field {
    position: relative;
    isolation: isolate;
  }
  .aa-grid-field::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--aa-space-8)) calc(50% - 50vw) calc(-1 * var(--aa-space-5));
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--aa-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--aa-grid) 1px, transparent 1px);
    background-size: var(--aa-grid-size) var(--aa-grid-size);
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 65% 70% at 50% 45%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 65% 70% at 50% 45%, #000 35%, transparent 100%);
    pointer-events: none;
  }
  /* Section heads: the bracketed label on a hairline, a serif heading and lead; centred when stacked, on the left in a
     wide row or band from 1100px, where the label's hairline runs only after it. */
  .aa-cell-head {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--aa-space-4);
    text-align: center;
  }
  .aa-center {
    margin-inline: auto;
  }
  /* A section lead never leaves one word on its last line (§1's "run." did once the head ran full width). */
  .aa-cell-head > .aa-lead {
    text-wrap: pretty;
  }
  @media (min-width: 68.75rem) {
    .aa-cell-head {
      justify-items: start;
      text-align: left;
    }
    .aa-cell-head .aa-center {
      margin-inline: 0;
    }
    .aa-cell-head :global(.aa-seclabel)::before {
      content: none;
    }
  }
  @media (max-width: 45rem) {
    .aa-grid-field::before {
      top: calc(-1 * var(--aa-space-7));
    }
  }
</style>
