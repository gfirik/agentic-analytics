---
// The hero exhibit (DESIGN.md §5–§6): a real report page from the recorded run (src/data/exhibit.json, written by
// scripts/generate.ts from the same run as the pipeline scene), rendered by the server in its final, verified state,
// in the hero's right column from 1100px and below the statement under it (site v4). It demonstrates itself, with no hover needed:
//   1. As it comes into view (only without prefers-reduced-motion) the figures count up to their recorded value
//      (600 ms, drawn over the real text, which keeps its place), then verify one by one: each chip's box draws in,
//      then its check appears (≤ 200 ms per figure, ≤ 2.5 s in all).
//   2. A guided walkthrough then steps through the story's key figures (walkthrough() in scripts/landing-data.ts),
//      opening each figure's margin note (its SQL or function, the sheet rows it read, or the quoted source) under a
//      step indicator. One behaviour at every size (site v3, D2): a step every few seconds while the notes are on
//      screen (beside the exhibit when it is at least 48rem wide, below it otherwise, where the step bar stays at the top), waiting
//      while the reader hovers or focuses inside; Pause stops it. Previous, next and replay are always there. Nothing
//      is pinned to the scroll. Step 1's note is open from the start, so the margin is never empty.
//   3. Hovering or focusing any chip still opens its note; a click pins it (touch). Esc closes it.
// With reduced motion or without JS the steps are a static ruled list under the exhibit, and every chip is a link to
// its row in the fact ledger.
import exhibit from "../../data/exhibit.json";
import landing from "../../data/landing.json";
import { formatWithCurrency } from "../format.ts";
import ExhibitNote, { type Note } from "./ExhibitNote.astro";

type Part = { text?: string; fact?: string; source?: string };
interface Step {
  id: string;
  title: string;
  figures: { id: string; note?: string }[];
  how: string;
}
const data = exhibit as unknown as {
  title: string;
  lines: Part[][];
  order: string[];
  notes: Record<string, Note>;
  walk: Step[];
};
const notes = data.notes;
const steps = data.walk;
const v = landing.verification;
const ledger = Object.values(
  landing.facts as Record<
    string,
    {
      id: string;
      label: string;
      value: number;
      unit: string;
      currency: string | null;
      verified: boolean;
      computation: { kind: string; fn?: string; inputs?: string[] };
    }
  >,
).sort((a, b) => Number(a.id.slice(1)) - Number(b.id.slice(1)));
const check = `<svg class="aa-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
const figure = (f: { id: string; note?: string }, i: number) => {
  const value = notes[f.id]?.value ?? f.id;
  return f.note ? ` (${value} ${f.note})` : `${i === 0 ? " " : ", "}${value}`;
};
const caption = (s: Step) => `${s.title}${s.figures.map(figure).join("")}`;
// Step 0 says what the verifier did to what the exhibit shows: figures recomputed, quotes checked against their file.
const shown = data.order.map((id) => notes[id]).filter((x): x is Note => Boolean(x?.verified));
const recomputed = shown.filter((x) => x.kind !== "source").length;
const quotes = shown.filter((x) => x.kind === "source").length;
const plural = (k: number, one: string, many: string) => `${k} ${k === 1 ? one : many}`;
---

<div class="aa-walk" data-exhibit data-steps={JSON.stringify(steps.map((s) => s.id))}>
  <script is:inline>
    // Before first paint: when motion is welcome, hold the figures unverified for the replay and switch the
    // walkthrough on (its step bar), so nothing shifts once the script runs. A safety net shows the
    // final state if the walkthrough script never runs.
    (() => {
      const el = document.currentScript?.parentElement;
      if (!el || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      el.dataset.anim = "pending";
      el.dataset.walk = "live";
      setTimeout(() => {
        if (!el.dataset.ready) {
          el.dataset.anim = "done";
          delete el.dataset.walk;
        }
      }, 4000);
    })();
  </script>
  <div class="aa-walk-body">
    <div class="aa-walk-bar">
      <p class="aa-walk-status" aria-live="polite">
        <span class="aa-walk-cap" data-step="0">
          <span class="aa-walk-n">{plural(recomputed, "figure", "figures")}</span> recomputed by the verifier{
            quotes ? `, ${plural(quotes, "quote", "quotes")} checked against its file` : ""
          } · {steps.length} steps below
        </span>
        {
          steps.map((s, i) => (
            <span class="aa-walk-cap" data-step={i + 1} hidden>
              <span class="aa-walk-n">
                {i + 1}/{steps.length}
              </span>{" "}
              {caption(s)} <span aria-hidden="true">→</span> <span class="aa-walk-how">{s.how}</span>
            </span>
          ))
        }
      </p>
      <div class="aa-walk-controls" role="group" aria-label="Walkthrough">
        <span class="aa-walk-dots" aria-hidden="true">
          {steps.map((_, i) => <span class="aa-walk-dot" data-dot={i + 1} />)}
        </span>
        <button type="button" class="aa-walk-btn" data-walk-prev aria-label="Previous step">←</button>
        <button type="button" class="aa-walk-btn" data-walk-next aria-label="Next step">→</button>
        <button type="button" class="aa-walk-btn aa-walk-pause" data-walk-pause>Pause</button>
        <button type="button" class="aa-walk-btn aa-walk-replay" data-walk-replay>Replay</button>
      </div>
    </div>
    <div class="aa-walk-grid">
      <figure class="aa-exhibit" aria-labelledby="aa-exhibit-title">
        <div class="aa-exhibit-page">
          <p id="aa-exhibit-title" class="aa-exhibit-title">{data.title}</p>
          {
            data.lines.map((line) => (
              <p class="aa-exhibit-line">
                {line.map((p) =>
                  p.fact ? (
                    <span class="aa-num"><span class="aa-fig">{notes[p.fact]?.value ?? p.fact}</span><a
                        class="aa-chip"
                        href={`#fact-${p.fact}`}
                        data-note={p.fact}
                        aria-describedby={`aa-note-${p.fact}-sum`}
                        aria-label={`${p.fact}${notes[p.fact]?.verified ? ", verified" : ""}: how this number was computed`}
                      >{notes[p.fact]?.verified ? <Fragment set:html={check} /> : null}{p.fact}</a></span>
                  ) : p.source ? (
                    <>
                      {" "}
                      <a
                        class="aa-chip"
                        href={`#source-${p.source}`}
                        data-note={p.source}
                        aria-describedby={`aa-note-${p.source}-sum`}
                        aria-label={`${p.source}${notes[p.source]?.verified ? ", verified" : ""}: the cited source`}
                      >
                        {notes[p.source]?.verified ? <Fragment set:html={check} /> : null}
                        {p.source}
                      </a>
                    </>
                  ) : (
                    p.text
                  ),
                )}
              </p>
            ))
          }
          <p class="aa-exhibit-foot">
            <Fragment set:html={check} /><span class="aa-sr">verified:</span>
            {v.numbers_checked} numbers recomputed, {v.numbers_mismatched} mismatched · {v.citations_checked} citations checked
          </p>
        </div>
        <figcaption class="aa-exhibit-caption">
          Recorded from a real engine run. Any number opens how it was computed. <a href="#ledger">Fact ledger</a>
        </figcaption>
      </figure>

      <div class="aa-notes">
        <span class="aa-leader" aria-hidden="true" hidden></span>
        {
          Object.values(notes).map((n) => (
            <aside class="aa-note" id={`aa-note-${n.id}`} data-note-for={n.id}>
              <ExhibitNote n={n} sumId={`aa-note-${n.id}-sum`} foldSql />
            </aside>
          ))
        }
      </div>
    </div>
  </div>

  <ol class="aa-walk-list" aria-label="Walkthrough: how the key figures were computed">
    {
      steps.map((s, i) => {
        const n = notes[s.id];
        return (
          <li class="aa-walk-item">
            <p class="aa-walk-item-head">
              <span class="aa-walk-n">
                {i + 1}/{steps.length}
              </span>{" "}
              {caption(s)} <span aria-hidden="true">→</span> <span class="aa-walk-how">{s.how}</span>
            </p>
            {n ? (
              <div class="aa-walk-item-note">
                <ExhibitNote n={n} />
              </div>
            ) : null}
          </li>
        );
      })
    }
  </ol>
</div>

<section id="ledger" class="aa-exhibit-ledger" aria-labelledby="aa-ledger-title">
  <h2 id="aa-ledger-title" class="aa-label">Fact ledger · every fact behind the exhibit</h2>
  <div class="aa-ledger-wrap" role="region" aria-label="Fact ledger" tabindex="0">
    <table class="aa-ledger">
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col" class="num">Value</th>
          <th scope="col">Fact</th>
          <th scope="col">Computed by</th>
          <th scope="col">Verified</th>
        </tr>
      </thead>
      <tbody>
        {
          ledger.map((f) => (
            <tr id={`fact-${f.id}`}>
              <td class="id">{f.id}</td>
              <td class="num aa-ledger-value">{formatWithCurrency(f)}</td>
              <td class="aa-ledger-label">{f.label}</td>
              <td class="aa-ledger-how">
                {f.computation.kind === "sql" ? "SQL in DuckDB" : `${f.computation.fn}(${(f.computation.inputs ?? []).join(", ")})`}
              </td>
              <td class="aa-ledger-ok">
                {f.verified ? (
                  <span class="aa-verified">
                    <Fragment set:html={check} /> recomputed
                  </span>
                ) : (
                  "no"
                )}
              </td>
            </tr>
          ))
        }
        {
          Object.values(notes)
            .filter((n) => n.kind === "source")
            .map((n) => (
              <tr id={`source-${n.id}`}>
                <td class="id">{n.id}</td>
                <td class="num aa-ledger-value">quote</td>
                <td class="aa-ledger-label">{n.label}</td>
                <td>
                  <q>{n.quote}</q>
                </td>
                <td class="aa-ledger-ok">
                  {n.verified ? (
                    <span class="aa-verified">
                      <Fragment set:html={check} /> checked
                    </span>
                  ) : (
                    "no"
                  )}
                </td>
              </tr>
            ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-exhibit]");
  if (wrap) {
    wrap.dataset.ready = "1";
    const chips = [...wrap.querySelectorAll<HTMLAnchorElement>(".aa-exhibit a.aa-chip[data-note]")];
    const col = wrap.querySelector<HTMLElement>(".aa-notes");
    const leader = wrap.querySelector<HTMLElement>(".aa-leader");
    const caps = [...wrap.querySelectorAll<HTMLElement>(".aa-walk-cap")];
    const dots = [...wrap.querySelectorAll<HTMLElement>(".aa-walk-dot")];
    const prev = wrap.querySelector<HTMLButtonElement>("[data-walk-prev]");
    const next = wrap.querySelector<HTMLButtonElement>("[data-walk-next]");
    const replay = wrap.querySelector<HTMLButtonElement>("[data-walk-replay]");
    const pause = wrap.querySelector<HTMLButtonElement>("[data-walk-pause]");
    const stepIds = JSON.parse(wrap.dataset.steps ?? "[]") as string[];
    const n = stepIds.length;
    const live = wrap.dataset.walk === "live";
    // The notes sit beside the exhibit when the exhibit is at least 48rem wide: a container query on .aa-walk, since its
    // width follows the hero's columns, not the screen (site v4: beside at 1440 in the hero's right column and from
    // about 840px where the hero stacks; below it in between).
    const besideAt = 48 * Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
    const beside = {
      get matches() {
        return wrap.clientWidth >= besideAt;
      },
    };
    const chipFor = (id: string) => chips.find((c) => c.dataset.note === id);

    // ── Notes ─────────────────────────────────────────────────────────────────────────────────────────────────
    let open: { chip: HTMLAnchorElement; note: HTMLElement } | undefined;
    let pinned = false;
    let returning = false; // focus going back to a chip after Esc: don't reopen its note
    let autoScroll = false; // the page is scrolling a pinned note into view
    let hideTimer = 0;
    let current = 0; // 0: the verification; 1..n: the walkthrough's steps
    const place = () => {
      if (!open || !col || !leader) return;
      const { chip, note } = open;
      if (!beside.matches) {
        note.style.top = "";
        leader.hidden = true;
        return;
      }
      const c = chip.getBoundingClientRect();
      const box = col.getBoundingClientRect();
      note.style.top = `${Math.max(0, c.top - box.top - 10)}px`;
      // The leader runs from the exhibit's edge, level with the figure, to the note: it never crosses the text.
      const page = wrap.querySelector<HTMLElement>(".aa-exhibit-page")?.getBoundingClientRect();
      const from = page ? page.right : c.right;
      leader.hidden = false;
      leader.style.top = `${c.top + c.height / 2 - box.top}px`;
      leader.style.left = `${from - box.left}px`;
      leader.style.width = `${Math.max(0, box.left - from)}px`;
    };
    const close = () => {
      if (!open) return;
      open.note.classList.remove("is-open");
      open.chip.setAttribute("aria-expanded", "false");
      open = undefined;
      pinned = false;
      if (leader) leader.hidden = true;
    };
    const show = (chip: HTMLAnchorElement) => {
      clearTimeout(hideTimer);
      const note = document.getElementById(`aa-note-${chip.dataset.note}`);
      if (!note) return;
      if (open?.chip !== chip) close();
      open = { chip, note };
      note.classList.add("is-open");
      chip.setAttribute("aria-expanded", "true");
      place();
    };
    // Back to the walkthrough's note once a hovered or pinned note lets go. Before the first step (and without the
    // walkthrough) that is step 1's note, so the margin is never an empty box.
    const settle = () => {
      pinned = false;
      const id = stepIds[Math.max(current, 1) - 1];
      const chip = id ? chipFor(id) : undefined;
      if (chip) show(chip);
      else close();
    };
    const later = () => {
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        if (!pinned) settle();
      }, 220);
    };
    for (const chip of chips) {
      chip.setAttribute("aria-expanded", "false");
      chip.setAttribute("aria-controls", `aa-note-${chip.dataset.note}`);
      chip.addEventListener("mouseenter", () => {
        if (!autoScroll) show(chip);
      });
      chip.addEventListener("mouseleave", later);
      chip.addEventListener("focus", () => {
        if (!returning) show(chip);
      });
      chip.addEventListener("blur", (e) => {
        const to = e.relatedTarget as Node | null;
        if (!(to && open?.note.contains(to))) later();
      });
      chip.addEventListener("click", (e) => {
        e.preventDefault();
        if (pinned && open?.chip === chip) return settle();
        show(chip);
        pinned = true;
        if (!beside.matches && open) {
          // Bringing the pinned note into view (smooth scrolling) carries other figures under a resting pointer:
          // their mouseenter must not take the note away while the page moves by itself.
          // (A scrollend left over from an earlier scroll can arrive first: only one after the page moved counts.)
          autoScroll = true;
          const from = window.scrollY;
          const settled = (e?: Event) => {
            if (e && window.scrollY === from) return;
            autoScroll = false;
            window.removeEventListener("scrollend", settled);
          };
          window.addEventListener("scrollend", settled);
          window.setTimeout(settled, 1200);
          open.note.scrollIntoView({ block: "nearest" });
        }
      });
    }
    col?.addEventListener("mouseenter", () => clearTimeout(hideTimer));
    col?.addEventListener("mouseleave", later);
    col?.addEventListener("focusout", (e) => {
      const to = e.relatedTarget as Node | null;
      if (!(to && (col.contains(to) || open?.chip === to))) later();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !open) return;
      const { chip, note } = open;
      const active = document.activeElement;
      const hadFocus = active === chip || (active !== null && note.contains(active));
      close();
      if (!hadFocus) return;
      returning = true;
      chip.focus();
      returning = false;
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (pinned && open && !open.note.contains(t) && !chips.some((c) => c.contains(t))) settle();
    });
    // "Show SQL": open beside the exhibit, folded below it (where the tallest note would otherwise be a long column).
    const folds = [...wrap.querySelectorAll<HTMLDetailsElement>(".aa-notes details[data-fold]")];
    // The notes column keeps the room of its tallest note, measured once its contents are final, so stepping from a
    // short note to a long one never moves the page. Beside the exhibit a note sits level with its figure, so its room
    // is its figure's offset plus its height; below the exhibit (one grid cell) the cell already holds the tallest.
    // It only grows: a smaller measure later (fonts in, a wider window) never pulls the page up under the reader.
    let reserved = 0;
    const reserve = () => {
      if (!col) return;
      if (!beside.matches) {
        reserved = 0;
        col.style.minHeight = "";
        return;
      }
      const box = col.getBoundingClientRect();
      let room = 0;
      for (const note of col.querySelectorAll<HTMLElement>(".aa-note")) {
        const chip = chipFor(note.dataset.noteFor ?? "");
        const was = note.classList.contains("is-open");
        note.classList.add("is-measure");
        const top = chip ? Math.max(0, chip.getBoundingClientRect().top - box.top - 10) : 0;
        room = Math.max(room, top + note.getBoundingClientRect().height);
        note.classList.remove("is-measure");
        if (was) note.classList.add("is-open");
      }
      reserved = Math.max(reserved, Math.ceil(room));
      col.style.minHeight = `${reserved}px`;
    };
    const fold = () => {
      for (const d of folds) d.open = beside.matches;
      reserve();
      place();
    };
    fold();
    let wasBeside = beside.matches;
    new ResizeObserver(() => {
      if (beside.matches === wasBeside) return;
      wasBeside = beside.matches;
      fold();
    }).observe(wrap);
    // A narrower column makes its notes taller: measure again (once a frame) as the window changes.
    let resizing = 0;
    window.addEventListener("resize", () => {
      place();
      if (!resizing)
        resizing = requestAnimationFrame(() => {
          resizing = 0;
          reserve();
        });
    });
    // The note is placed by its figure's box, and sized by its text: both move a little when the web fonts arrive.
    document.fonts?.ready.then(() => {
      reserve();
      place();
    });

    // ── The walkthrough (only when motion is welcome: data-walk="live", set before first paint) ──────────────
    if (live && n > 0) {
      let timers: number[] = []; // the verification's
      let stepTimer = 0; // the next step
      let auto = true; // advancing by itself until the reader steps by hand or pauses
      let notesOnScreen = false; // it advances only while the reader can see the notes
      let started = false;
      // The reader is exploring: the pointer on a figure or a note, or focus inside the exhibit. Two flags, so leaving a
      // chip with the mouse doesn't let it run while focus is still inside.
      const held = { pointer: false, focus: false };
      const clearTimers = () => {
        for (const t of timers) clearTimeout(t);
        timers = [];
        clearTimeout(stepTimer);
      };
      // Prev and next stay focusable at the ends (aria-disabled), so a keyboard reader never loses focus.
      const able = (b: HTMLButtonElement | null, on: boolean) => b?.setAttribute("aria-disabled", String(!on));
      // The button names the action it will take (Pause while running, Play while paused), so its state is visible and
      // spoken alike; with a changing label it carries no aria-pressed (ARIA Authoring Practices, button pattern).
      const status = wrap.querySelector<HTMLElement>(".aa-walk-status");
      const showPause = () => {
        if (pause) pause.textContent = auto ? "Pause" : "Play";
        // The caption is announced when the reader moves a step, not every 4.5 s while it advances by itself: the region
        // stays polite (switching it from off to live can drop the first update) and is busy while autoplaying.
        status?.setAttribute("aria-busy", String(auto));
      };
      const setStep = (k: number) => {
        current = Math.max(0, Math.min(n, k));
        caps.forEach((c, i) => {
          c.hidden = i !== current;
        });
        dots.forEach((d, i) => d.classList.toggle("is-on", i < current));
        chips.forEach((c) => c.classList.toggle("is-step", current > 0 && c.dataset.note === stepIds[current - 1]));
        able(prev, current > 0);
        able(next, current < n);
        if (!pinned) settle();
      };
      // The count: every figure runs up to its recorded value together (each number in it, from zero, in the figure's
      // own format). It is drawn over the figure (data-count, CSS), whose real text never changes and keeps its place,
      // so nothing reflows; it always ends on the real value, which is what the HTML holds.
      const COUNT = 600;
      const figs = [...wrap.querySelectorAll<HTMLElement>(".aa-exhibit .aa-fig")];
      let counting = 0;
      const NUM = /\d[\d,]*(?:\.\d+)?/g;
      const at = (text: string, t: number) =>
        text.replace(NUM, (m) => {
          const decimals = m.split(".")[1]?.length ?? 0;
          const value = Number(m.replace(/,/g, "")) * t;
          return value.toLocaleString("en-US", {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
            useGrouping: m.includes(","),
          });
        });
      const count = () => {
        cancelAnimationFrame(counting);
        for (const f of figs) {
          f.classList.remove("is-counted");
          f.dataset.count = at(f.textContent ?? "", 0);
        }
        const t0 = performance.now();
        const frame = (now: number) => {
          const t = Math.min(1, (now - t0) / COUNT);
          const eased = 1 - (1 - t) ** 3;
          for (const f of figs) {
            if (t < 1) f.dataset.count = at(f.textContent ?? "", eased);
            else {
              delete f.dataset.count;
              f.classList.add("is-counted");
            }
          }
          if (t < 1) counting = requestAnimationFrame(frame);
        };
        counting = requestAnimationFrame(frame);
      };
      // The verification: as the count lands, one figure every ≤ 200 ms in reading order; the last check by 2.5 s.
      const verify = () => {
        wrap.dataset.anim = "pending";
        for (const c of chips) c.classList.remove("is-verified");
        void wrap.offsetWidth;
        count();
        const lead = COUNT - 140; // the check fades in 140 ms after its chip is marked: on the count's last frame
        const step = Math.min(200, 1600 / Math.max(chips.length, 1));
        chips.forEach((chip, i) => {
          timers.push(window.setTimeout(() => chip.classList.add("is-verified"), lead + i * step));
        });
        const total = lead + chips.length * step + 300;
        timers.push(
          window.setTimeout(() => {
            wrap.dataset.anim = "done";
          }, total),
        );
        return total;
      };
      // A step every few seconds while the notes are on screen.
      const DWELL = 4500;
      const tick = (delay: number) => {
        clearTimeout(stepTimer);
        stepTimer = window.setTimeout(() => {
          if (!auto || held.pointer || held.focus || !notesOnScreen) return;
          setStep(current + 1);
          if (current < n) tick(DWELL);
          else {
            // The end: nothing advances any more, so the button offers Play (which starts again from step 1).
            auto = false;
            showPause();
          }
        }, delay);
      };
      const start = () => {
        clearTimers();
        started = true;
        const took = verify();
        setStep(0);
        tick(took + 600);
      };
      setStep(0);
      showPause();
      // The verification runs once the report page's top is above the bottom sixth of the screen. In the two-column
      // hero (from 1100px) the report page is on the first screen, so it plays on load; stacked, it starts as the page
      // comes into view, then runs on its timer (DESIGN §6). A margin, not a visible ratio: a ratio can't be reached by
      // a box taller than the screen (a landscape phone).
      const page = wrap.querySelector<HTMLElement>(".aa-exhibit-page");
      new IntersectionObserver(
        ([e]) => {
          if (e?.isIntersecting && !started) start();
        },
        { rootMargin: "0px 0px -15% 0px" },
      ).observe(page ?? wrap);
      if (col)
        new IntersectionObserver(
          ([e]) => {
            notesOnScreen = Boolean(e?.isIntersecting);
            if (notesOnScreen && started && auto && current < n) tick(current === 0 ? 1500 : DWELL);
          },
          { rootMargin: "-25% 0px -25% 0px" },
        ).observe(col);
      // It waits while the reader explores (hover or focus inside the exhibit), and resumes after.
      const hold = (by: "pointer" | "focus", on: boolean) => {
        held[by] = on;
        if (!held.pointer && !held.focus && auto && notesOnScreen && current < n) tick(DWELL);
      };
      // The pointer holds it only on a figure or a note (a pointer resting anywhere over the wide exhibit while the
      // reader scrolls would stop it before it starts); focus anywhere inside the exhibit holds it. The step bar's own
      // buttons never do.
      const grid = wrap.querySelector<HTMLElement>(".aa-walk-grid") ?? wrap;
      for (const el of [...chips, ...(col ? [col] : [])]) {
        el.addEventListener("mouseenter", () => hold("pointer", true));
        el.addEventListener("mouseleave", () => hold("pointer", false));
      }
      grid.addEventListener("focusin", () => hold("focus", true));
      grid.addEventListener("focusout", (e) => {
        if (!grid.contains(e.relatedTarget as Node | null)) hold("focus", false);
      });
      const go = (k: number) => {
        if (k < 0 || k > n) return;
        auto = false;
        clearTimeout(stepTimer);
        showPause();
        setStep(k);
      };
      prev?.addEventListener("click", () => go(current - 1));
      next?.addEventListener("click", () => go(current + 1));
      // Pause and play (WCAG 2.2.2): stepping by hand pauses too.
      pause?.addEventListener("click", () => {
        auto = !auto;
        showPause();
        if (auto && current >= n) setStep(1);
        if (auto) tick(DWELL);
        else clearTimeout(stepTimer);
      });
      replay?.addEventListener("click", () => {
        auto = true;
        pinned = false;
        showPause();
        start();
      });
    } else settle();
  }
</script>

