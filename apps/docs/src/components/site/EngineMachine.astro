---
// <EngineMachine />: the engine drawn as a factory line, live in its own band under the hero (DESIGN.md §6 "Engine
// machine", the one 3D exception of §1, §2.6 and §9; its motion in §7). The still frame (rendered at build time from the
// same scene by scripts/site-assets.ts) shows at once; three.js (machine-3d.ts, its own chunk) starts on idle after load
// once the band is near, and draws over it. As the reader scrolls through the band, a sticky stage stays put and the camera moves from station
// to station; hovering (or tapping) a station shows its card. The labels, the card and the station list are this HTML.
// Without JS, under reduced motion and on weak devices it is the still frame with the station list, and three never
// loads. Every station, its stages and its figures come from the recorded run (engine-machine.ts).
import { getCollection } from "astro:content";
import pipeline from "../../../../../docs/assets/readme/pipeline.json";
import type { PipelineData } from "../pipeline-scene.ts";
import { type LearnStage, learnPath, machineStations, STILLS, type Station, sceneInput, sidePieces, tourOrder } from "./engine-machine.ts";
import { withBase } from "./site.ts";

const run = pipeline as unknown as PipelineData;
const stations = machineStations(run);
const sides = sidePieces(run);
const tour = tourOrder(stations);
const data = { scene: sceneInput(run), tour };

// The Learn pages' own titles, so a link reads as the page it opens (and a missing page fails the build).
const learnPages = await getCollection("docs", (e) => e.id.startsWith("learn/stages/"));
const learnTitle = (slug: LearnStage) => {
  const page = learnPages.find((e) => e.id === `learn/stages/${slug}`);
  if (!page) throw new Error(`engine machine: no Learn page learn/stages/${slug}`);
  return page.data.title;
};
const factHref = (fid: string) => `${withBase("")}#fact-${fid}`;
const check = `<svg class="aa-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
const img = (file: string) => withBase(file);
const callers = stations.filter((s) => s.info.calls.length > 0).map((s) => s.info.name);
const and = (xs: readonly string[]) => (xs.length < 2 ? (xs[0] ?? "") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);
const kicker = (s: Station) =>
  // The stages, unless the only one is the station's own name ("Verify · Verify").
  `${s.n ? `Station ${s.n}` : "Beside the line"} · ${s.info.name}${s.stages.length && !(s.stages.length === 1 && s.stages[0]?.toLowerCase() === s.info.name.toLowerCase()) ? ` · ${s.stages.join(" · ")}` : ""}`;
const stillAlt = `The engine drawn as a factory line: ${stations.length} stations on a conveyor from the doors to the report, the job's database file in front and the model room behind glass. Every station is described in "Every station, as a list" below.`;
---

<div class="aa-engine" data-machine style={`--aa-engine-stops: ${tour.length + 1}`}>
  <script is:inline>
    // Before first paint, so the band's height never changes after it: "live" (a tall band with a sticky stage, the
    // list folded) for a capable device; "still" (the still frame and the open list) under reduced motion, on a weak
    // device or with Save-Data. Without JS there is no mode: the still layout.
    (function (root) {
      var n = navigator;
      var weak = (n.hardwareConcurrency || 4) <= 2 || (n.deviceMemory || 4) <= 2 || !!(n.connection && n.connection.saveData);
      var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      root.setAttribute("data-mode", weak || reduced ? "still" : "live");
    })(document.currentScript.parentElement);
  </script>
  <div class="aa-engine-track" data-track>
    <div class="aa-engine-stage" data-engine-stage>
      <div class="aa-engine-view" data-viewport>
        <picture class="aa-engine-still">
          <source media="(max-width: 39.99rem)" type="image/webp" srcset={img("machine-tall.webp")} width={STILLS.tall[0]} height={STILLS.tall[1]} />
          <source media="(max-width: 39.99rem)" type="image/png" srcset={img("machine-tall.png")} width={STILLS.tall[0]} height={STILLS.tall[1]} />
          <source type="image/webp" srcset={img("machine-wide.webp")} width={STILLS.wide[0]} height={STILLS.wide[1]} />
          <img src={img("machine-wide.png")} width={STILLS.wide[0]} height={STILLS.wide[1]} alt={stillAlt} loading="lazy" decoding="async" />
        </picture>
        <div class="aa-engine-tags" data-tags>
          {
            [...stations, ...sides].map((s) => (
              <button type="button" class:list={["aa-engine-tag", { "is-side": !s.n }]} data-tag data-id={s.key} aria-pressed="false">
                {s.n ? <span class="aa-engine-tag-n">{s.n}</span> : null}
                <span class="aa-engine-tag-t">{s.info.simple}</span>
              </button>
            ))
          }
        </div>
        <div class="aa-engine-progress" aria-hidden="true"><i data-bar></i></div>
      </div>
      <div class="aa-engine-card" data-card>
        <p class="aa-label aa-engine-card-kicker" data-card-kicker>How to read the machine</p>
        <p class="aa-engine-card-title" data-card-title>Files in on the left, a checked report out on the right</p>
        <div class="aa-engine-card-body" data-card-body>
          <div class="aa-station-body" data-overview>
            <p>
              {and(callers)} sit behind glass: they call a model, and no model is allowed to write a number. Every number is computed by the database,
              then computed again by the verifier.
            </p>
            <p>The long tank in front is the job's database file, where every station saves its work; the room at the back holds the models.</p>
            <p class="aa-engine-live-only">Scroll to move down the line, or point at a station to see what it does.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" data-machine-data set:html={JSON.stringify(data)} />

  <details class="aa-engine-list" id="aa-engine-list" open>
    <summary>Every station, as a list</summary>
    {
      [
        { label: "The stations, in the order a job runs them", items: stations, ordered: true },
        { label: "Beside the line", items: sides, ordered: false },
      ].map((group) => {
        const Tag = group.ordered ? "ol" : "ul";
        return (
          <>
            <p class="aa-label aa-stations-label">{group.label}</p>
            <Tag class="aa-stations">
              {group.items.map((s) => (
                <li class="aa-station" data-station={s.key}>
                  <p class="aa-label aa-station-kicker">{kicker(s)}</p>
                  <p class="aa-station-title">{s.info.simple}</p>
                  <div class="aa-station-body">
                    <p class="aa-station-plain">
                      <span class="aa-station-lead">{s.info.plain[0]}</span> <span class="aa-station-more">{s.info.plain[1]}</span>
                    </p>
                    <p class="aa-station-model">
                      {s.info.calls.length ? `Calls a model: the ${and(s.info.calls)}.` : s.key === "models" ? "The models themselves." : "No model: plain code."}
                    </p>
                    {s.run.length ? (
                      <dl class="aa-station-run">
                        {s.run.map((r) => (
                          <div>
                            <dt>{r.label}</dt>
                            <dd>
                              {r.value}
                              {r.facts?.map((f) => (
                                <span class="aa-station-fact">
                                  <span class="aa-fig">{f.text}</span>
                                  <a class="aa-chip" href={factHref(f.id)} aria-label={`${f.id}, verified`}>
                                    <Fragment set:html={check} />
                                    {f.id}
                                  </a>
                                </span>
                              ))}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    ) : null}
                    <p class="aa-station-learn">
                      Learn:{" "}
                      {s.info.learn.map((slug, i) => (
                        <>
                          {i > 0 ? " · " : null}
                          <a href={withBase(learnPath(slug))}>{learnTitle(slug)}</a>
                        </>
                      ))}
                    </p>
                  </div>
                </li>
              ))}
            </Tag>
          </>
        );
      })
    }
  </details>
  <script is:inline>
    // Live, the list folds under its summary (the stage and its card show every station); before first paint.
    (function (list) {
      if (list.parentElement.getAttribute("data-mode") === "live") list.open = false;
    })(document.currentScript.previousElementSibling);
  </script>
</div>

<script>
  import type { Live, MachineData } from "./machine-3d.ts";

  const PHONE = "(max-width: 39.99rem)";
  const WIDE = "(min-width: 60rem)";

  const webgl = () => {
    try {
      const c = document.createElement("canvas");
      const gl = c.getContext("webgl2") ?? c.getContext("webgl");
      if (!gl) return false;
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return true;
    } catch {
      return false;
    }
  };
  /** After load, when the browser is idle (with a timeout, and a plain timer where there is no requestIdleCallback). */
  const idle = () =>
    new Promise<void>((ok) => {
      const go = () =>
        "requestIdleCallback" in window ? requestIdleCallback(() => ok(), { timeout: 2000 }) : setTimeout(ok, 1200);
      if (document.readyState === "complete") go();
      else addEventListener("load", go, { once: true });
    });
  /** Once the element is within `margin` of the viewport. */
  const near = (el: Element, margin: string) =>
    new Promise<void>((ok) => {
      const io = new IntersectionObserver(
        (es) => {
          if (es.some((e) => e.isIntersecting)) {
            io.disconnect();
            ok();
          }
        },
        { rootMargin: margin },
      );
      io.observe(el);
    });

  for (const root of document.querySelectorAll<HTMLElement>("[data-machine]")) {
    if (root.dataset.mode !== "live") continue;
    const track = root.querySelector<HTMLElement>("[data-track]");
    const stage = root.querySelector<HTMLElement>("[data-engine-stage]");
    const card = root.querySelector<HTMLElement>("[data-card]");
    const list = root.querySelector<HTMLElement>(".aa-engine-list");
    const bar = root.querySelector<HTMLElement>("[data-bar]");
    const json = root.querySelector("script[data-machine-data]")?.textContent;
    if (!track || !stage || !card || !list || !bar || !json) continue;
    const data = JSON.parse(json) as MachineData;
    const kickerEl = card.querySelector<HTMLElement>("[data-card-kicker]");
    const titleEl = card.querySelector<HTMLElement>("[data-card-title]");
    const bodyEl = card.querySelector<HTMLElement>("[data-card-body]");
    const overview = bodyEl?.firstElementChild?.cloneNode(true) ?? null;
    const overviewHead = [kickerEl?.textContent ?? "", titleEl?.textContent ?? ""] as const;
    const stops = data.tour.length;

    // The card: the station's own entry in the list (cloned), or the overview at the home view.
    let shown: string | null = "";
    const show = (key: string | null, prefix?: string) => {
      if (key === shown || !kickerEl || !titleEl || !bodyEl) return;
      shown = key;
      if (!key) {
        kickerEl.textContent = overviewHead[0];
        titleEl.textContent = overviewHead[1];
        bodyEl.replaceChildren(...(overview ? [overview.cloneNode(true)] : []));
        return;
      }
      const li = list.querySelector<HTMLElement>(`[data-station="${key}"]`);
      if (!li) return;
      const k = li.querySelector(".aa-station-kicker")?.textContent ?? "";
      kickerEl.textContent = prefix ? `${prefix} · ${k}` : k;
      titleEl.textContent = li.querySelector(".aa-station-title")?.textContent ?? "";
      const body = li.querySelector(".aa-station-body")?.cloneNode(true);
      bodyEl.replaceChildren(...(body ? [body] : []));
    };

    // The scroll: how far through the band the reader is, in stops (0 is the home view).
    let live: Live | null = null;
    let stop = -1;
    let hover: string | null = null;
    const span = () => Math.max(1, track.offsetHeight - stage.offsetHeight);
    const progress = () => {
      const top = track.getBoundingClientRect().top - (parseFloat(getComputedStyle(stage).top) || 0);
      return Math.min(1, Math.max(0, -top / span()));
    };
    const update = () => {
      const p = progress();
      const f = p * stops;
      bar.style.transform = `scaleX(${p.toFixed(4)})`;
      live?.setProgress(f);
      const s = Math.round(f);
      if (s !== stop) {
        stop = s;
        hover = null;
        const key = s === 0 ? null : (data.tour[s - 1] ?? null);
        show(key, key ? `Stop ${s} of ${stops}` : undefined);
        live?.highlight(key);
      }
    };
    let ticking = false;
    addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      },
      { passive: true },
    );
    addEventListener("resize", update, { passive: true });
    update();

    // A station picked by hover, focus or a tap shows its card and highlight until the scroll reaches another stop.
    const pick = (key: string | null) => {
      if (!key || key === hover) return;
      hover = key;
      show(key);
      live?.highlight(key);
    };
    /** Scroll the page so the camera stops at this piece (the tour's position for it). */
    const go = (key: string) => {
      const i = data.tour.indexOf(key);
      if (i < 0) return;
      const y = track.getBoundingClientRect().top + scrollY + ((i + 1) / stops) * span() - (parseFloat(getComputedStyle(stage).top) || 0);
      scrollTo({ top: Math.ceil(y), behavior: "smooth" });
    };
    for (const t of root.querySelectorAll<HTMLButtonElement>("[data-tag]")) {
      const key = t.dataset.id ?? "";
      t.addEventListener("pointerenter", () => pick(key));
      t.addEventListener("focus", () => pick(key));
      t.addEventListener("click", () => go(key));
    }

    // three.js: on idle after load, once the band is near (within a quarter screen below the viewport; a whole screen on
    // phones, which scroll faster and draw a lighter scene). Creating the WebGL context and compiling the shaders is one
    // long task on a GPU-less machine, so a reader who never comes here never pays for it, and the first screen's
    // input stays free. If WebGL or the chunk fails, the still frame stays, with the card still following the scroll.
    const phone = matchMedia(PHONE).matches;
    const start = async () => {
      await idle();
      await near(track, phone ? "100% 0px" : "0px 0px 25% 0px");
      if (!webgl()) return;
      try {
        const m = await import("./machine-3d.ts");
        live = await m.mount(stage, data, {
          detail: phone ? "lite" : "full",
          drift: !phone,
          onHover: (k) => pick(k),
          onPick: (k) => pick(k),
          coveredRight: () => (matchMedia(WIDE).matches ? card.offsetWidth + 24 : 0), // the card and its 24px inset
        });
        root.dataset.gl = "on";
        stop = -1;
        update();
      } catch {
        // The still frame and the scroll-linked card are the fallback, so the reader sees nothing break; the state is
        // marked so a test (or a developer) can see the live view failed to start.
        root.dataset.gl = "failed";
      }
    };
    void start();
  }
</script>

<style>
  .aa-engine {
    --aa-engine-h: clamp(37.5rem, 100svh - 3rem, 45rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--aa-space-5);
    text-align: left;
  }

  /* The band: with JS on a capable device it is tall, and the stage stays put inside it while the reader scrolls
     through (one scroll span per stop, so the camera moves from station to station). Its height is set before first
     paint, so it never shifts. Otherwise (no JS, reduced motion, a weak device) it is just the stage. */
  .aa-engine[data-mode="live"] .aa-engine-track {
    height: calc(var(--aa-engine-h) + var(--aa-engine-stops) * 22svh);
  }
  .aa-engine-stage {
    position: relative;
    height: var(--aa-engine-h);
  }
  .aa-engine[data-mode="live"] .aa-engine-stage {
    position: sticky;
    top: max(var(--aa-space-5), (100svh - var(--aa-engine-h)) / 2);
  }
  .aa-engine-view {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--aa-page);
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
  }
  .aa-engine-still,
  .aa-engine-still img,
  .aa-engine-view :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .aa-engine-still img {
    object-fit: contain;
  }
  /* The canvas fades in over the still once its first frame is drawn. */
  .aa-engine-view :global(canvas) {
    animation: aa-engine-in 400ms var(--aa-ease) both;
  }
  @keyframes aa-engine-in {
    from {
      opacity: 0;
    }
  }

  /* The station labels: buttons placed by the live view from projected coordinates; hidden until it places them. */
  .aa-engine-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .aa-engine-tag {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    pointer-events: auto;
    min-height: 1.5rem;
    padding: 0.125rem 0.375rem;
    white-space: nowrap;
    font: 500 var(--aa-text-label) / 1.3 var(--aa-font-mono);
    letter-spacing: var(--aa-label-tracking);
    text-transform: uppercase;
    color: var(--aa-ink);
    background: var(--aa-raised);
    border: 1px solid var(--aa-rule-strong);
    border-radius: var(--aa-radius-chip);
    cursor: pointer;
    transition:
      background-color var(--aa-fast) var(--aa-ease),
      color var(--aa-fast) var(--aa-ease),
      border-color var(--aa-fast) var(--aa-ease);
  }
  .aa-engine:not([data-gl="on"]) .aa-engine-tag {
    display: none;
  }
  .aa-engine-tag-n {
    color: var(--aa-ink-3);
    margin-right: var(--aa-space-1);
  }
  .aa-engine-tag.is-side {
    color: var(--aa-ink-2);
    background: var(--aa-surface);
  }
  .aa-engine-tag:hover {
    border-color: var(--aa-ink);
  }
  .aa-engine-tag[aria-pressed="true"] {
    z-index: 2;
    color: var(--aa-page);
    background: var(--aa-ink);
    border-color: var(--aa-ink);
  }
  .aa-engine-tag[aria-pressed="true"] .aa-engine-tag-n {
    color: var(--aa-page);
  }
  /* On a narrow or wide-open view the labels show their numbers only; the name stays in the button's text for screen
     readers and comes back on hover, focus or when pressed. */
  .aa-engine-tags.is-compact .aa-engine-tag:not(.is-side, [aria-pressed="true"], :hover, :focus-visible) .aa-engine-tag-t {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .aa-engine-tags.is-compact .aa-engine-tag:not(.is-side, [aria-pressed="true"], :hover, :focus-visible) .aa-engine-tag-n {
    margin-right: 0;
  }
  .aa-engine-tags.is-compact .aa-engine-tag:focus-visible,
  .aa-engine-tags.is-compact .aa-engine-tag:hover {
    z-index: 3;
  }

  /* How far through the band the reader is: a 2px ink rule along the view's foot (live only). */
  .aa-engine-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--aa-rule);
  }
  .aa-engine-progress i {
    display: block;
    height: 100%;
    background: var(--aa-ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  .aa-engine:not([data-mode="live"]) .aa-engine-progress,
  .aa-engine:not([data-mode="live"]) .aa-engine-live-only {
    display: none;
  }

  /* The card: the station in view (or under the pointer), its kicker, title, what it does, its figures in the run and
     its Learn pages. From 60rem it sits over the view's right side; below, under the view. */
  .aa-engine-card {
    display: grid;
    align-content: start;
    gap: var(--aa-space-2);
    padding: var(--aa-space-4) var(--aa-space-5) var(--aa-space-5);
    background: var(--aa-raised);
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
  }
  .aa-engine-card p {
    margin: 0;
  }
  .aa-engine-card-title,
  .aa-station-title {
    margin: 0;
    font: 600 var(--aa-text-h3) / 1.4 var(--aa-font-sans);
    color: var(--aa-ink);
  }
  .aa-engine-card-body {
    margin-top: var(--aa-space-1);
  }
  @media (min-width: 60rem) {
    /* The still frame fills the part of the view the card leaves free, as the live home view does. */
    .aa-engine-still {
      right: calc(22rem + var(--aa-space-5));
    }
    .aa-engine-card {
      position: absolute;
      z-index: 4;
      top: var(--aa-space-5);
      right: var(--aa-space-5);
      width: 22rem;
      max-height: calc(100% - 2 * var(--aa-space-5));
      overflow: hidden;
    }
  }
  @media (max-width: 59.99rem) {
    .aa-engine {
      --aa-engine-h: auto;
    }
    .aa-engine-stage {
      display: grid;
      grid-template-rows: auto auto;
      gap: var(--aa-space-3);
    }
    .aa-engine-view {
      position: relative;
      height: min(30rem, 56svh);
    }
    .aa-engine[data-mode="live"] .aa-engine-track {
      height: calc(100svh + var(--aa-engine-stops) * 18svh);
    }
    .aa-engine[data-mode="live"] .aa-engine-stage {
      top: var(--aa-space-3);
    }
    /* Live on a narrow screen the card stays short: what it does in one sentence, and its Learn pages. The list has
       the rest. */
    .aa-engine[data-mode="live"] .aa-engine-card {
      padding: var(--aa-space-3) var(--aa-space-4);
    }
    /* The kicker on one line and the title holding two, so the card's text keeps its place as the scroll moves from
       stop to stop: a kicker or title that wrapped differently moved the lines under it (layout shifts, site v4 PR 3). */
    .aa-engine[data-mode="live"] .aa-engine-card-kicker {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .aa-engine[data-mode="live"] .aa-engine-card-title {
      min-height: calc(2 * 1.4em);
    }
    .aa-engine[data-mode="live"] .aa-engine-card :is(.aa-station-more, .aa-station-model, .aa-station-run, [data-overview] p:not(.aa-engine-live-only)) {
      display: none;
    }
  }

  /* The list: open without JS and in the still mode; folded under its summary when live. */
  .aa-engine-list > summary {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    cursor: pointer;
    font: 500 var(--aa-text-small) / 1.4 var(--aa-font-sans);
    color: var(--aa-ink);
    text-decoration: underline;
    text-decoration-color: var(--aa-rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .aa-stations-label {
    margin: var(--aa-space-5) 0 var(--aa-space-2);
  }
  .aa-stations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--aa-rule-strong);
  }
  .aa-station {
    display: grid;
    gap: var(--aa-space-2);
    align-content: start;
    padding: var(--aa-space-4) 0;
