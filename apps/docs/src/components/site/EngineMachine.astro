---
// <EngineMachine />: the engine drawn as a factory line, live in its own band under the hero (DESIGN.md §6 "Engine
// machine", the one 3D exception of §1, §2.6 and §9; its motion in §7). The still frame (rendered at build time from the
// same scene by scripts/site-assets.ts) shows at once; three.js (machine-3d.ts, its own chunk) starts on idle after load
// once the band is near, and draws over it. Site v5: the stage fills the screen and stays put while the reader scrolls
// through the band (the tour: seven stops, the camera easing between them); a click on the canvas (or the Explore
// button on phones) hands the camera to the reader (explore: rotate, zoom, pan, pick a station), and Back to tour, Esc
// or a click outside hands it back. The section's head (the "head" slot) sits over the stage's top left at the home
// view and fades as the tour starts. The labels, the card, the buttons and the station list are this HTML.
// Without JS, under reduced motion and on weak devices it is the still frame with the station list, and three never
// loads. Every station, its stages and its figures come from the recorded run (engine-machine.ts).
import { getCollection } from "astro:content";
import pipeline from "../../../../../docs/assets/readme/pipeline.json";
import type { PipelineData } from "../pipeline-scene.ts";
import { type LearnStage, learnPath, machineStations, STILLS, type Station, sceneInput, sidePieces, tourStops } from "./engine-machine.ts";
import { withBase } from "./site.ts";

const run = pipeline as unknown as PipelineData;
const stations = machineStations(run);
const sides = sidePieces(run);
const tour = tourStops(stations);
const data = { scene: sceneInput(run), tour: tour.map((t) => ({ key: t.key, members: t.members })) };
const pieces = [...stations, ...sides];
const pieceOf = (key: string) => pieces.find((p) => p.key === key);

// The Learn pages' own titles, so a link reads as the page it opens (and a missing page fails the build).
const learnPages = await getCollection("docs", (e) => e.id.startsWith("learn/stages/"));
const learnTitle = (slug: LearnStage) => {
  const page = learnPages.find((e) => e.id === `learn/stages/${slug}`);
  if (!page) throw new Error(`engine machine: no Learn page learn/stages/${slug}`);
  return page.data.title;
};
const factHref = (fid: string) => `${withBase("")}#fact-${fid}`;
const check = `<svg class="aa-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
const img = (file: string) => withBase(file);
const callers = stations.filter((s) => s.info.calls.length > 0).map((s) => s.info.name);
const and = (xs: readonly string[]) => (xs.length < 2 ? (xs[0] ?? "") : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`);
const kicker = (s: Station) =>
  // The stages, unless the only one is the station's own name ("Verify · Verify").
  `${s.n ? `Station ${s.n}` : "Beside the line"} · ${s.info.name}${s.stages.length && !(s.stages.length === 1 && s.stages[0]?.toLowerCase() === s.info.name.toLowerCase()) ? ` · ${s.stages.join(" · ")}` : ""}`;
/** A group stop's kicker: its stations' numbers only, so it stays one line (the card's title and list name the rest). */
const groupKicker = (members: readonly string[]) => {
  const ns = members.map((k) => pieceOf(k)?.n).filter((n): n is string => !!n);
  return ns.length > 1 ? `Stations ${ns[0]}–${ns.at(-1)}` : ns.length ? `Station ${ns[0]}` : "Beside the line";
};
const groupLearn = (members: readonly string[]) => [...new Set(members.flatMap((k) => (pieceOf(k)?.info.learn ?? []) as LearnStage[]))];
const stillAlt = `The engine drawn as a factory line: ${stations.length} stations on a conveyor from the doors to the report, the job's database file in front and the model room behind glass. Every station is described in "Every station, as a list" below.`;
---

<div class="aa-engine" data-machine data-view="tour" style={`--aa-engine-stops: ${tour.length + 1}`}>
  <script is:inline>
    // Before first paint, so the band's height never changes after it: "live" (a tall band with a sticky stage, the
    // list folded) for a capable device; "still" (the still frame and the open list) under reduced motion, on a weak
    // device or with Save-Data. Without JS there is no mode: the still layout.
    (function (root) {
      var n = navigator;
      var weak = (n.hardwareConcurrency || 4) <= 2 || (n.deviceMemory || 4) <= 2 || !!(n.connection && n.connection.saveData);
      var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      root.setAttribute("data-mode", weak || reduced ? "still" : "live");
    })(document.currentScript.parentElement);
  </script>
  <div class="aa-engine-head" data-head>
    <div class="aa-engine-head-in"><slot name="head" /></div>
  </div>
  <div class="aa-engine-track" data-track>
    <div class="aa-engine-stage" data-engine-stage>
      <div class="aa-engine-view" data-viewport>
        <picture class="aa-engine-still">
          <source media="(max-width: 39.99rem)" type="image/webp" srcset={img("machine-tall.webp")} width={STILLS.tall[0]} height={STILLS.tall[1]} />
          <source media="(max-width: 39.99rem)" type="image/png" srcset={img("machine-tall.png")} width={STILLS.tall[0]} height={STILLS.tall[1]} />
          <source type="image/webp" srcset={img("machine-wide.webp")} width={STILLS.wide[0]} height={STILLS.wide[1]} />
          <img src={img("machine-wide.png")} width={STILLS.wide[0]} height={STILLS.wide[1]} alt={stillAlt} loading="lazy" decoding="async" />
        </picture>
        <div class="aa-engine-tags" data-tags>
          {
            pieces.map((s) => (
              <button type="button" class:list={["aa-engine-tag", { "is-side": !s.n }]} data-tag data-id={s.key} aria-pressed="false">
                {s.n ? <span class="aa-engine-tag-n">{s.n}</span> : null}
                <span class="aa-engine-tag-t">{s.info.simple}</span>
              </button>
            ))
          }
        </div>
        <p class="aa-engine-hint" aria-hidden="true">Click to explore</p>
        <div class="aa-engine-modes">
          <button type="button" class="aa-button aa-button-secondary aa-engine-mode" data-explore aria-controls="aa-engine-card">
            Explore
          </button>
          <button type="button" class="aa-button aa-button-secondary aa-engine-mode" data-back hidden>Back to tour</button>
        </div>
        <div class="aa-engine-progress" aria-hidden="true"><i data-bar></i></div>
      </div>
      <div class="aa-engine-card" id="aa-engine-card" data-card>
        <p class="aa-label aa-engine-card-kicker" data-card-kicker>How to read the machine</p>
        <p class="aa-engine-card-title" data-card-title>Files in on the left, a checked report out on the right</p>
        <div class="aa-engine-card-body" data-card-body>
          <div class="aa-station-body" data-overview>
            <p>
              {and(callers)} sit behind glass: they call a model, and no model is allowed to write a number. Every number is computed by the database,
              then computed again by the verifier.
            </p>
            <p>The long tank in front is the job's database file, where every station saves its work; the room at the back holds the models.</p>
            <p class="aa-engine-live-only">Scroll to move down the line, or explore the machine yourself.</p>
          </div>
        </div>
      </div>
      <p class="aa-engine-sr" aria-live="polite" data-announce></p>
    </div>
  </div>
  <script type="application/json" data-machine-data set:html={JSON.stringify(data)} />
  {/* The card's content for each stop that shows several pieces, and for explore's start (hidden: the card clones
      it); a single piece's stop shows that piece's own entry from the list. */}
  {
    tour.map((t, i) =>
      t.members.length > 1 ? (
        <div hidden data-stop-card={i + 1}>
          <p data-k>{groupKicker(t.members)}</p>
          <p data-t>{t.title}</p>
          <div class="aa-station-body">
            <ul class="aa-engine-members">
              {t.members.map((k) => (
                <li>
                  <span class="aa-engine-member">{pieceOf(k)?.info.simple}</span>
                  <span class="aa-engine-member-lead"> {pieceOf(k)?.info.plain[0]}</span>
                </li>
              ))}
            </ul>
            <p class="aa-station-learn">
              Learn:{" "}
              {groupLearn(t.members).map((slug, j) => (
                <>
                  {j > 0 ? " · " : null}
                  <a href={withBase(learnPath(slug))}>{learnTitle(slug)}</a>
                </>
              ))}
            </p>
          </div>
        </div>
      ) : null,
    )
  }
  <div hidden data-explore-card>
    <p data-k>Explore</p>
    <p data-t>Turn it, zoom in, pick a station</p>
    <div class="aa-station-body">
      <p>Drag to turn the machine, scroll or pinch to zoom, and right-drag or use two fingers to move it. Choose any station to see what it does.</p>
      <p>Back to tour (or Esc) returns to the stop you scrolled to.</p>
    </div>
  </div>

  <details class="aa-engine-list" id="aa-engine-list" open>
    <summary>Every station, as a list</summary>
    {
      [
        { label: "The stations, in the order a job runs them", items: stations, ordered: true },
        { label: "Beside the line", items: sides, ordered: false },
      ].map((group) => {
        const Tag = group.ordered ? "ol" : "ul";
        return (
          <>
            <p class="aa-label aa-stations-label">{group.label}</p>
            <Tag class="aa-stations">
              {group.items.map((s) => (
                <li class="aa-station" data-station={s.key}>
                  <p class="aa-label aa-station-kicker">{kicker(s)}</p>
                  <p class="aa-station-title">{s.info.simple}</p>
                  <div class="aa-station-body">
                    <p class="aa-station-plain">
                      <span class="aa-station-lead">{s.info.plain[0]}</span> <span class="aa-station-more">{s.info.plain[1]}</span>
                    </p>
                    <p class="aa-station-model">
                      {s.info.calls.length ? `Calls a model: the ${and(s.info.calls)}.` : s.key === "models" ? "The models themselves." : "No model: plain code."}
                    </p>
                    {s.run.length ? (
                      <dl class="aa-station-run">
                        {s.run.map((r) => (
                          <div>
                            <dt>{r.label}</dt>
                            <dd>
                              {r.value}
                              {r.facts?.map((f) => (
                                <span class="aa-station-fact">
                                  <span class="aa-fig">{f.text}</span>
                                  <a class="aa-chip" href={factHref(f.id)} aria-label={`${f.id}, verified`}>
                                    <Fragment set:html={check} />
                                    {f.id}
                                  </a>
                                </span>
                              ))}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    ) : null}
                    <p class="aa-station-learn">
                      Learn:{" "}
                      {s.info.learn.map((slug, i) => (
                        <>
                          {i > 0 ? " · " : null}
                          <a href={withBase(learnPath(slug))}>{learnTitle(slug)}</a>
                        </>
                      ))}
                    </p>
                  </div>
                </li>
              ))}
            </Tag>
          </>
        );
      })
    }
  </details>
  <script is:inline>
    // Live, the list folds under its summary (the stage and its card show every station); before first paint.
    (function (list) {
      if (list.parentElement.getAttribute("data-mode") === "live") list.open = false;
    })(document.currentScript.previousElementSibling);
  </script>
</div>

<script>
  import type { Live, MachineData, Mode } from "./machine-3d.ts";

  const PHONE = "(max-width: 39.99rem)";
  const WIDE = "(min-width: 60rem)";
  /** Phones and touch screens (site v5): no hover hint, an Explore button instead of a click on the canvas. */
  const TOUCH = "(max-width: 56.24rem), (pointer: coarse)";

  const webgl = () => {
    try {
      const c = document.createElement("canvas");
      const gl = c.getContext("webgl2") ?? c.getContext("webgl");
      if (!gl) return false;
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      return true;
    } catch {
      return false;
    }
  };
  /** After load, when the browser is idle (with a timeout, and a plain timer where there is no requestIdleCallback). */
  const idle = () =>
    new Promise<void>((ok) => {
      const go = () =>
        "requestIdleCallback" in window ? requestIdleCallback(() => ok(), { timeout: 2000 }) : setTimeout(ok, 1200);
      if (document.readyState === "complete") go();
      else addEventListener("load", go, { once: true });
    });
  /** Once the element is within `margin` of the viewport. */
  const near = (el: Element, margin: string) =>
    new Promise<void>((ok) => {
      const io = new IntersectionObserver(
        (es) => {
          if (es.some((e) => e.isIntersecting)) {
            io.disconnect();
            ok();
          }
        },
        { rootMargin: margin },
      );
      io.observe(el);
    });
  const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));

  for (const root of document.querySelectorAll<HTMLElement>("[data-machine]")) {
    if (root.dataset.mode !== "live") continue;
    const track = root.querySelector<HTMLElement>("[data-track]");
    const stage = root.querySelector<HTMLElement>("[data-engine-stage]");
    const viewport = root.querySelector<HTMLElement>("[data-viewport]");
    const head = root.querySelector<HTMLElement>(".aa-engine-head-in");
    const card = root.querySelector<HTMLElement>("[data-card]");
    const list = root.querySelector<HTMLElement>(".aa-engine-list");
    const bar = root.querySelector<HTMLElement>("[data-bar]");
    const exploreBtn = root.querySelector<HTMLButtonElement>("[data-explore]");
    const backBtn = root.querySelector<HTMLButtonElement>("[data-back]");
    const announcer = root.querySelector<HTMLElement>("[data-announce]");
    const json = root.querySelector("script[data-machine-data]")?.textContent;
    if (!track || !stage || !viewport || !head || !card || !list || !bar || !exploreBtn || !backBtn || !announcer || !json) continue;
    const data = JSON.parse(json) as MachineData;
    let kickerEl = card.querySelector<HTMLElement>("[data-card-kicker]");
    let titleEl = card.querySelector<HTMLElement>("[data-card-title]");
    let bodyEl = card.querySelector<HTMLElement>("[data-card-body]");
    const overview = bodyEl?.firstElementChild?.cloneNode(true) ?? null;
    const overviewHead = [kickerEl?.textContent ?? "", titleEl?.textContent ?? ""] as const;
    const stops = data.tour.length;
    const wide = () => matchMedia(WIDE).matches;

    // The card: a piece's own entry in the list (cloned), a stop's group (its template), explore's start, or the
    // overview at the home view.
    let shown: string | null = "";
    // The card's kicker, title and body are replaced by new nodes, not edited in place: a title that wraps to another
    // line would otherwise move the body under it, which counts as a layout shift; new content is not a shift.
    const fresh = <T extends HTMLElement>(el: T) => {
      const n = el.cloneNode(false) as T;
      el.replaceWith(n);
      return n;
    };
    const fill = (kicker: string, title: string, body: Node | null) => {
      if (!kickerEl || !titleEl || !bodyEl) return;
      kickerEl = fresh(kickerEl);
      titleEl = fresh(titleEl);
      bodyEl = fresh(bodyEl);
      kickerEl.textContent = kicker;
      titleEl.textContent = title;
      bodyEl.replaceChildren(...(body ? [body] : []));
      card.scrollTop = 0;
    };
    const fromTemplate = (sel: string, id: string, prefix?: string) => {
      const c = root.querySelector<HTMLElement>(sel);
      if (!c || shown === id) return;
      shown = id;
      const k = c.querySelector("[data-k]")?.textContent ?? "";
      fill(prefix ? `${prefix} · ${k}` : k, c.querySelector("[data-t]")?.textContent ?? "", c.querySelector(".aa-station-body")?.cloneNode(true) ?? null);
    };
    const show = (key: string | null, prefix?: string) => {
      const id = `${prefix ?? ""}|${key ?? ""}`;
      if (id === shown) return;
      if (!key) {
        shown = id;
        fill(overviewHead[0], overviewHead[1], overview ? overview.cloneNode(true) : null);
        return;
      }
      const li = list.querySelector<HTMLElement>(`[data-station="${key}"]`);
      if (!li) return;
      shown = id;
      const k = li.querySelector(".aa-station-kicker")?.textContent ?? "";
      fill(prefix ? `${prefix} · ${k}` : k, li.querySelector(".aa-station-title")?.textContent ?? "", li.querySelector(".aa-station-body")?.cloneNode(true) ?? null);
    };

    // The scroll: how far through the band the reader is, in stops (0 is the home view). Each stop, the home view
    // included, holds an equal share of the band.
    let live: Live | null = null;
    let view: Mode = "tour";
    let stop = -1;
    let hover: string | null = null;
    const span = () => Math.max(1, track.offsetHeight - stage.offsetHeight);
    const stickyTop = () => parseFloat(getComputedStyle(stage).top) || 0;
    const progress = () => {
      const top = track.getBoundingClientRect().top - stickyTop();
      return Math.min(1, Math.max(0, -top / span()));
    };
    const showStop = (s: number) => {
      const t = s === 0 ? null : data.tour[s - 1];
      if (!t) {
        show(null);
        live?.highlight([]);
        return;
      }
      const prefix = `Stop ${s} of ${stops}`;
      if (t.members.length > 1) fromTemplate(`[data-stop-card="${s}"]`, `stop|${s}`, prefix);
      else show(t.key, prefix);
      live?.highlight(t.members);
    };
    const update = () => {
      const p = progress();
      const f = clamp(p * (stops + 1) - 0.5, 0, stops);
      bar.style.transform = `scaleX(${p.toFixed(4)})`;
      // The head sits over the home view and fades as the tour starts (opacity only).
      root.style.setProperty("--aa-engine-head-o", (1 - clamp(f / 0.45, 0, 1)).toFixed(3));
      if (view === "explore") return;
      live?.setProgress(f);
      const s = Math.round(f);
      if (s !== stop) {
        stop = s;
        hover = null;
        showStop(s);
      }
    };

    // Explore (site v5): the reader turns, zooms and pans the machine; the scroll is paused under it.
    let exploreY = 0;
    const announce = (text: string) => {
      announcer.textContent = text;
    };
    const touch = () => matchMedia(TOUCH).matches;
    const pick = (key: string | null) => {
      if (!key || key === hover) return;
      hover = key;
      show(key);
      live?.highlight([key]);
    };
    const enter = (key: string | null) => {
      if (!live || view === "explore") return;
      const fromButton = document.activeElement === exploreBtn;
      view = "explore";
      root.dataset.view = "explore";
      live.setMode("explore");
      exploreY = scrollY;
      hover = null;
      if (key) pick(key);
      else {
        fromTemplate("[data-explore-card]", "explore");
        live.highlight([]);
      }
      backBtn.hidden = false;
      exploreBtn.hidden = true;
      if (fromButton) backBtn.focus();
      announce("Explore mode: drag to turn the machine, scroll or pinch to zoom, and choose a station to see what it does. Back to tour or Escape returns.");
    };
    const leave = () => {
      if (!live || view !== "explore") return;
      const hadFocus = document.activeElement === backBtn;
      view = "tour";
      root.dataset.view = "tour";
      live.setMode("tour");
      exploreBtn.hidden = false;
      backBtn.hidden = true;
      if (hadFocus) exploreBtn.focus();
      stop = -1;
      update();
      announce(stop === 0 ? "Back to the tour." : `Back to the tour, stop ${stop} of ${stops}.`);
    };
    exploreBtn.addEventListener("click", () => enter(null));
    backBtn.addEventListener("click", () => leave());
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && view === "explore") leave();
    });
    // A press anywhere outside the view and the card returns to the tour.
    addEventListener(
      "pointerdown",
      (e) => {
        if (view !== "explore") return;
        const t = e.target as Node | null;
        if (t && (viewport.contains(t) || card.contains(t))) return;
        leave();
      },
      { capture: true },
    );
    // In explore the wheel turns into zoom over the canvas (OrbitControls) and does nothing elsewhere on the stage, so
    // the page doesn't scroll from under the pinned machine; a card that can scroll still scrolls.
    stage.addEventListener(
      "wheel",
      (e) => {
        if (view !== "explore") return;
        if (card.contains(e.target as Node) && card.scrollHeight > card.clientHeight + 1) return;
        e.preventDefault();
      },
      { passive: false },
    );

    let ticking = false;
    addEventListener(
      "scroll",
      () => {
        // Scrolling the page by other means (the keyboard, the scrollbar) is the tour's: it leaves explore.
        if (view === "explore" && Math.abs(scrollY - exploreY) > 48) leave();
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      },
      { passive: true },
    );
    addEventListener("resize", update, { passive: true });
    update();

    /** Scroll the page so the camera stops at the stop that shows this piece. */
    const go = (key: string) => {
      const i = data.tour.findIndex((t) => t.members.includes(key));
      if (i < 0) return;
      const y = track.getBoundingClientRect().top + scrollY + ((i + 1.5) / (stops + 1)) * span() - stickyTop();
      scrollTo({ top: Math.ceil(y), behavior: "smooth" });
    };
    for (const t of root.querySelectorAll<HTMLButtonElement>("[data-tag]")) {
      const key = t.dataset.id ?? "";
      t.addEventListener("pointerenter", () => pick(key));
      t.addEventListener("focus", () => pick(key));
      t.addEventListener("click", () => (view === "explore" ? pick(key) : go(key)));
    }

    // three.js: on idle after load, once the band is near (within a quarter screen below the viewport; a whole screen on
    // phones, which scroll faster and draw a lighter scene). Creating the WebGL context and compiling the shaders is one
    // long task on a GPU-less machine, so a reader who never comes here never pays for it, and the first screen's
    // input stays free. If WebGL or the chunk fails, the still frame stays, with the card still following the scroll.
    const phone = matchMedia(PHONE).matches;
    const start = async () => {
      await idle();
      await near(track, phone ? "100% 0px" : "0px 0px 25% 0px");
      if (!webgl()) return;
      try {
        const m = await import("./machine-3d.ts");
        live = await m.mount(stage, data, {
          detail: phone ? "lite" : "full",
          drift: !phone,
          onHover: (k) => {
            if (view === "tour") pick(k);
          },
          onTap: (k, pointer) => {
            if (view === "explore") pick(k);
            else if (pointer !== "touch" && !touch()) enter(k);
            else pick(k);
          },
          coveredRight: () => (wide() ? card.offsetWidth + 24 : 0), // the card and its 24px inset
          coveredTop: () => (wide() ? head.offsetHeight : 0),
        });
        root.dataset.gl = "on";
        stop = -1;
        update();
      } catch {
        // The still frame and the scroll-linked card are the fallback, so the reader sees nothing break; the state is
        // marked so a test (or a developer) can see the live view failed to start.
        root.dataset.gl = "failed";
      }
    };
    void start();
  }
</script>

<style>
  .aa-engine {
    --aa-engine-h: clamp(37.5rem, 100svh - 3rem, 45rem);
    text-align: left;
  }

  /* The frame (index.astro's .aa-cell): the head and the list keep the page's 1440px frame and its side rules; the
     live stage between them is full-bleed, with no box around it (site v5). */
  .aa-engine-head,
  .aa-engine-list,
  .aa-engine:not([data-mode="live"]) .aa-engine-track {
    max-width: var(--aa-container);
    margin: 0 auto;
    padding-inline: var(--aa-gutter);
    border-inline: 1px solid var(--aa-rule);
  }
  .aa-engine-head {
    padding-block: var(--aa-space-8) var(--aa-space-7);
  }
  .aa-engine-list {
