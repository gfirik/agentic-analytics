---
// The hero's background system (DESIGN.md §5 "Hero field", §7; site v5 PR 1, made bold in PR 1b). Rendered inside the
// hero statement, it runs full-bleed behind it and never behind the exhibit:
// - graph paper (24px minor lines, 96px major lines, a dot on every crossing) fading out radially from the statement;
// - the accent glow (`--aa-accent`): a cobalt bloom over the headline, a deeper one on the side the exhibit is on, and
//   a soft wash between them; never stronger than 22% of the accent behind text, so the lead keeps AA;
// - a fine grain (an inline SVG noise in a data URI: no image request);
// - the ledger network on a canvas: square nodes drifting, joined by elbowed connectors that draw themselves in, and
//   pulses of the accent running along them toward the exhibit (rightward in the wide row, downward when stacked),
//   hopping node to node and lighting each node they reach.
// The first three are CSS and static. The canvas is the only motion, and it is cheap and polite:
// - it starts on idle after load and fades in (opacity only), so it costs nothing on the first paint and never shifts
//   the layout (the canvas is absolutely positioned and sized by CSS);
// - it draws only while the hero is on screen (IntersectionObserver) and the tab is visible, at most 30 frames a
//   second, with no layout reads per frame (sizes come from a ResizeObserver; the direction from a media query);
// - its backing store is DPR-aware and capped (DPR ≤ 2 and about 1.6 million pixels); the pulse's halo is drawn once
//   to a sprite and stamped, never blurred per frame;
// - none of it under prefers-reduced-motion or Save-Data, or without JS: the static field is all there is;
// - there is no pause control (site v5 PR 2, the maintainer's call, DESIGN.md §7): it always plays while on screen,
//   pausing only off-screen and in a hidden tab, for cost.
---

<div class="aa-hero-field" aria-hidden="true">
  <div class="aa-hf-glow"></div>
  <div class="aa-hf-grid"></div>
  <canvas class="aa-hf-net" data-state="off"></canvas>
  <div class="aa-hf-grain"></div>
</div>

<script>
  const field = document.querySelector<HTMLElement>(".aa-hero-field");
  const canvas = field?.querySelector<HTMLCanvasElement>(".aa-hf-net") ?? null;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  // The exhibit is to the right from 1100px and below the statement under it: pulses run toward it.
  const wide = matchMedia("(min-width: 68.75rem)");
  const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
  const ctx = canvas?.getContext("2d") ?? null;

  if (field && canvas && ctx && !reduce.matches && !saveData && typeof IntersectionObserver !== "undefined") {
    type Node = { x: number; y: number; vx: number; vy: number; s: number; filled: boolean; flip: boolean; lit: number };
    type Link = { a: number; b: number; d: number; born: number };
    type Pulse = { a: number; b: number; t: number; hops: number };
    type Debug = HTMLCanvasElement & { aaFrames?: number; aaLinks?: number; aaPulses?: number; aaDrawn?: number };
    const css = getComputedStyle(document.documentElement);
    const accent = css.getPropertyValue("--aa-accent").trim() || "#2f3fe8";
    const deep = css.getPropertyValue("--aa-accent-deep").trim() || "#2433c4";
    const page = css.getPropertyValue("--aa-page").trim() || "#f8f8f6";
    /** A token's hex colour at an alpha, for canvas gradients (which take plain colours). */
    const rgba = (hex: string, a: number) => {
      const n = Number.parseInt(hex.replace("#", ""), 16);
      return `rgb(${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255} / ${a})`;
    };
    const FRAME = 1000 / 30; // at most 30 frames a second
    const LINK = 150; // px (taxicab): nodes closer than this may be joined
    const DRAW_IN = 900; // ms for a connector to draw itself in
    const PULSE_MS = 1100; // ms for a pulse to run one connector
    const MAX_PULSES = 6;
    const MAX_PIXELS = 1_600_000;

    let w = 0;
    let h = 0;
    let nodes: Node[] = [];
    const links = new Map<string, Link>();
    const pulses: Pulse[] = [];
    let clock = 0; // ms of running time: draw-in and pulses advance only while the net runs
    let nextPulse = 400;
    let onScreen = false;
    let raf = 0;
    let last = 0;
    let acc = 0;
    let frames = 0;
    // Deterministic per load (no Math.random flicker between frames): a small LCG.
    let seed = 0x2f6e2b1;
    const rnd = () => {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      return seed / 2 ** 32;
    };

    // The pulse's halo: a radial gradient drawn once to a small canvas, then stamped with drawImage (no shadowBlur).
    const HALO = 28;
    const halo = document.createElement("canvas");
    halo.width = halo.height = HALO * 2;
    {
      const g = halo.getContext("2d");
      if (g) {
        const r = g.createRadialGradient(HALO, HALO, 0, HALO, HALO, HALO);
        r.addColorStop(0, rgba(accent, 0.55));
        r.addColorStop(0.35, rgba(accent, 0.22));
        r.addColorStop(1, rgba(accent, 0));
        g.fillStyle = r;
        g.fillRect(0, 0, HALO * 2, HALO * 2);
      }
    }

    const seedNodes = () => {
      const n = Math.max(16, Math.min(64, Math.round((w * h) / 11000)));
      nodes = Array.from({ length: n }, () => {
        const speed = 6 + rnd() * 10; // px a second: a drift, never a motion that pulls the eye
        const dir = rnd() * Math.PI * 2;
        return {
          x: rnd() * w,
          y: rnd() * h,
          vx: Math.cos(dir) * speed,
          vy: Math.sin(dir) * speed,
          s: rnd() < 0.3 ? 6 : 4,
          filled: rnd() < 0.28,
          flip: rnd() < 0.5,
          lit: 0,
        };
      });
    };

    const resize = (cw: number, ch: number) => {
      if (cw === w && ch === h) return;
      const first = w === 0;
      w = cw;
      h = ch;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (w * h * dpr * dpr > MAX_PIXELS) dpr = Math.max(1, Math.sqrt(MAX_PIXELS / (w * h)));
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (first) seedNodes();
      else
        for (const p of nodes) {
          p.x = Math.min(p.x, w);
          p.y = Math.min(p.y, h);
        }
      relink();
      draw();
    };

    /** How far toward the exhibit a node is: its x in the wide row, its y when stacked. */
    const toward = (p: Node) => (wide.matches ? p.x : p.y);

    /**
     * Each node joins its two nearest neighbours within reach, so the net stays sparse. A connector that appears is
     * born now and draws itself in; the first ones are staggered along the way to the exhibit, so the net assembles as
     * a sweep toward it.
     */
    const relink = () => {
      const seen = new Set<string>();
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i] as Node;
        let b1 = -1;
        let d1 = LINK;
        let b2 = -1;
        let d2 = LINK;
        for (let j = 0; j < nodes.length; j++) {
          if (j === i) continue;
          const b = nodes[j] as Node;
          const d = Math.abs(a.x - b.x) + Math.abs(a.y - b.y);
          if (d < d1) {
            b2 = b1;
            d2 = d1;
            b1 = j;
            d1 = d;
          } else if (d < d2) {
            b2 = j;
            d2 = d;
          }
        }
        for (const [j, d] of [
          [b1, d1],
          [b2, d2],
        ] as const) {
          if (j < 0) continue;
          const key = i < j ? `${i}:${j}` : `${j}:${i}`;
          if (seen.has(key)) continue;
          seen.add(key);
          const link = links.get(key);
          if (link) link.d = d;
          else {
            const span = wide.matches ? w : h;
            const stagger = clock < DRAW_IN ? (Math.min(toward(a), span) / Math.max(span, 1)) * 1400 : 0;
            links.set(key, { a: Math.min(i, j), b: Math.max(i, j), d, born: clock + stagger });
          }
        }
      }
      for (const key of links.keys()) if (!seen.has(key)) links.delete(key);
    };

    /**
     * The corner of the elbowed connector between nodes i and j, horizontal then vertical (or the other way): the
     * ledger's own right angles. It is fixed by the pair (the lower index's flip), not by the direction it is run in,
     * so a connector never snaps its corner when a pulse runs it the other way.
     */
    const corner = (i: number, j: number) => {
      const lo = nodes[Math.min(i, j)] as Node;
      const hi = nodes[Math.max(i, j)] as Node;
      return lo.flip ? { x: hi.x, y: lo.y } : { x: lo.x, y: hi.y };
    };
    /** The point a fraction t along the elbow from node i to node j. */
    const pointOn = (i: number, j: number, t: number) => {
      const a = nodes[i] as Node;
      const b = nodes[j] as Node;
      const c = corner(i, j);
      const l1 = Math.abs(c.x - a.x) + Math.abs(c.y - a.y);
      const l2 = Math.abs(b.x - c.x) + Math.abs(b.y - c.y);
      const d = t * (l1 + l2);
      if (d <= l1 || l2 === 0) {
        const k = l1 ? d / l1 : 0;
        return { x: a.x + (c.x - a.x) * k, y: a.y + (c.y - a.y) * k };
      }
      const k = (d - l1) / l2;
      return { x: c.x + (b.x - c.x) * k, y: c.y + (b.y - c.y) * k };
    };
    /** The elbow from a toward b, drawn up to the fraction t (the draw-in). The corner is the one the a→b order gives. */
    const elbowTo = (i: number, j: number, t: number) => {
      const a = nodes[i] as Node;
      const b = nodes[j] as Node;
      const c = corner(i, j);
      ctx.moveTo(a.x, a.y);
      const l1 = Math.abs(c.x - a.x) + Math.abs(c.y - a.y);
      const l2 = Math.abs(b.x - c.x) + Math.abs(b.y - c.y);
      if (t * (l1 + l2) > l1) ctx.lineTo(c.x, c.y);
      const q = t >= 1 ? b : pointOn(i, j, t);
      ctx.lineTo(q.x, q.y);
    };
    /** A connector's ends in the order a pulse runs it: toward the exhibit. */
    const ordered = (l: Link): [number, number] =>
      toward(nodes[l.a] as Node) <= toward(nodes[l.b] as Node) ? [l.a, l.b] : [l.b, l.a];

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.lineWidth = 1;
      let drawn = 0;
      for (const l of links.values()) {
        const t = Math.max(0, Math.min(1, (clock - l.born) / DRAW_IN));
        if (t <= 0) continue;
        if (t >= 1) drawn++;
        const [i, j] = ordered(l);
        ctx.globalAlpha = 0.55 * (1 - l.d / LINK) ** 0.5 + 0.12;
        ctx.strokeStyle = accent;
        ctx.beginPath();
        // Ease-out on the draw-in, so a connector arrives rather than slides.
        elbowTo(i, j, 1 - (1 - t) ** 3);
        ctx.stroke();
      }
      for (const p of pulses) {
        const a = nodes[p.a];
        if (!a || !nodes[p.b]) continue;
        const q = pointOn(p.a, p.b, Math.min(p.t, 1));
        // A short tail behind the head: the last fifth of the run, brighter toward the head.
        const tail = pointOn(p.a, p.b, Math.max(0, Math.min(p.t, 1) - 0.2));
        const grad = ctx.createLinearGradient(tail.x, tail.y, q.x, q.y);
        grad.addColorStop(0, rgba(deep, 0));
        grad.addColorStop(1, deep);
        ctx.globalAlpha = 1;
        ctx.strokeStyle = grad;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(tail.x, tail.y);
        // The tail follows the elbow when it spans the corner.
        const c = corner(p.a, p.b);
        const before = (pt: { x: number; y: number }) => Math.abs(pt.x - a.x) + Math.abs(pt.y - a.y);
        if (before(tail) < before(c) && before(q) > before(c)) ctx.lineTo(c.x, c.y);
        ctx.lineTo(q.x, q.y);
        ctx.stroke();
        ctx.lineWidth = 1;
        ctx.globalAlpha = 0.9;
        ctx.drawImage(halo, q.x - HALO, q.y - HALO);
        ctx.fillStyle = deep;
        ctx.fillRect(Math.round(q.x) - 1.5, Math.round(q.y) - 1.5, 3, 3);
      }
      for (const p of nodes) {
        const x = Math.round(p.x - p.s / 2) + 0.5;
        const y = Math.round(p.y - p.s / 2) + 0.5;
        if (p.lit > 0) {
          // A node a pulse reached: a ring that opens and fades.
          const k = 1 - p.lit;
          ctx.globalAlpha = 0.6 * p.lit;
          ctx.strokeStyle = accent;
          const r = p.s / 2 + 2 + 8 * k;
          ctx.strokeRect(Math.round(p.x - r) + 0.5, Math.round(p.y - r) + 0.5, Math.round(2 * r), Math.round(2 * r));
        }
        if (p.filled || p.lit > 0) {
          ctx.globalAlpha = 0.9;
          ctx.fillStyle = p.lit > 0 ? deep : accent;
          ctx.fillRect(x - 0.5, y - 0.5, p.s, p.s);
        } else {
          ctx.globalAlpha = 0.9;
          ctx.fillStyle = page;
          ctx.fillRect(x, y, p.s - 1, p.s - 1);
          ctx.strokeStyle = accent;
          ctx.strokeRect(x, y, p.s - 1, p.s - 1);
        }
      }
      ctx.globalAlpha = 1;
      const dbg = canvas as Debug;
      dbg.aaLinks = links.size;
      dbg.aaDrawn = drawn;
      dbg.aaPulses = pulses.length;
    };

    /** A new pulse on a drawn connector, starting from its end farther from the exhibit; it prefers the far side. */
    const spawn = () => {
      const ready = [...links.values()].filter((l) => clock - l.born >= DRAW_IN);
      if (!ready.length) return;
      // Bias toward connectors far from the exhibit, so a pulse has somewhere to run.
      let pick = ready[Math.floor(rnd() * ready.length)] as Link;
      for (let k = 0; k < 2; k++) {
        const other = ready[Math.floor(rnd() * ready.length)] as Link;
        if (toward(nodes[ordered(other)[0]] as Node) < toward(nodes[ordered(pick)[0]] as Node)) pick = other;
      }
      const [a, b] = ordered(pick);
      pulses.push({ a, b, t: 0, hops: 0 });
    };

    /** At its end node a pulse lights it, then takes a connector onward toward the exhibit, if there is one. */
    const hop = (p: Pulse): boolean => {
      const at = nodes[p.b] as Node;
      at.lit = 1;
      if (p.hops >= 6) return false;
      let next: number | null = null;
      let gain = 4; // px: an onward connector must make real progress toward the exhibit
      for (const l of links.values()) {
        if (clock - l.born < DRAW_IN || (l.a !== p.b && l.b !== p.b)) continue;
        const other = l.a === p.b ? l.b : l.a;
        if (other === p.a) continue;
        const g = toward(nodes[other] as Node) - toward(at);
        if (g > gain) {
          gain = g;
          next = other;
        }
      }
      if (next === null) return false;
      p.a = p.b;
      p.b = next;
      p.t = 0;
      p.hops++;
      return true;
    };

    const step = (dt: number) => {
      clock += dt;
      const s = dt / 1000;
      for (const p of nodes) {
        p.x += p.vx * s;
        p.y += p.vy * s;
        if (p.x < -8 || p.x > w + 8) p.vx = -p.vx;
        if (p.y < -8 || p.y > h + 8) p.vy = -p.vy;
        if (p.lit > 0) p.lit = Math.max(0, p.lit - dt / 700);
      }
      relink();
      for (let k = pulses.length - 1; k >= 0; k--) {
        const p = pulses[k] as Pulse;
        p.t += dt / PULSE_MS;
        if (p.t >= 1 && !hop(p)) pulses.splice(k, 1);
      }
      if ((nextPulse -= dt) <= 0) {
        if (pulses.length < MAX_PULSES) spawn();
        nextPulse = 450 + rnd() * 650;
      }
    };

    const tick = (now: number) => {
      raf = requestAnimationFrame(tick);
      const dt = Math.min(now - last, 100);
      last = now;
      acc += dt;
      if (acc < FRAME) return;
      step(Math.min(acc, 100));
      acc = 0;
      draw();
      frames++;
      (canvas as Debug).aaFrames = frames;
    };

    const running = () => onScreen && !document.hidden && !reduce.matches;
    const sync = () => {
      const go = running();
      if (go && !raf) {
        last = performance.now();
        acc = 0;
        raf = requestAnimationFrame(tick);
      } else if (!go && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
      canvas.dataset.state = reduce.matches ? "off" : go ? "running" : "paused";
    };

    const start = () => {
      const ro = new ResizeObserver((entries) => {
        const box = entries[0]?.contentRect;
        if (box) resize(Math.round(box.width), Math.round(box.height));
      });
      ro.observe(canvas);
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) onScreen = e.isIntersecting;
          sync();
        },
        { rootMargin: "0px" },
      ).observe(field);
      document.addEventListener("visibilitychange", sync);
      // Switched to reduced motion mid-visit: stop and clear (the static field remains).
      reduce.addEventListener("change", () => {
        if (!reduce.matches) return;
        sync();
        ctx.clearRect(0, 0, w, h);
        field.classList.remove("is-live");
      });
      canvas.dataset.state = "paused";
      field.classList.add("is-live");
    };

    const later = () =>
      "requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 600);
    if (document.readyState === "complete") later();
    else window.addEventListener("load", later, { once: true });
  }
</script>

<style>
  /* The field: full-bleed behind the statement. Stacked (under 1100px) it spans the screen's width over the statement;
     in the wide row it runs from the screen's left edge to the middle of the gap before the exhibit. It reaches up to
     the header's hairline (the cell's top padding) and a little below the statement. 50vw / 100vw include a classic
     scrollbar's width, so it can reach a few pixels past the viewport: .aa-paper's overflow-x: clip hides that. */
  .aa-hero-field {
    --hf-x: 50%;
    --hf-y: 42%;
    --hf-mask: radial-gradient(ellipse 62% 62% at var(--hf-x) var(--hf-y), #000 24%, rgb(0 0 0 / 0.5) 58%, transparent 100%);
    position: absolute;
    inset: calc(-1 * var(--aa-space-8)) calc(50% - 50vw) calc(-1 * var(--aa-space-7));
    z-index: -1;
    pointer-events: none;
    contain: strict;
  }
  @media (min-width: 68.75rem) {
    .aa-hero-field {
      /* The statement's centre, measured from the field's right edge (the middle of the gap): half the gap plus half
         the statement (cqi: the statement is an inline-size container). */
      --hf-x: calc(100% - var(--aa-space-5) - 50cqi);
      --hf-y: 40%;
      --hf-mask: radial-gradient(ellipse 58% 64% at var(--hf-x) var(--hf-y), #000 22%, rgb(0 0 0 / 0.5) 56%, transparent 100%);
      inset: calc(-1 * var(--aa-space-8)) calc(-1 * var(--aa-space-5)) calc(-1 * var(--aa-space-8))
        calc(-1 * (var(--aa-gutter) + max(0px, (100vw - var(--aa-container)) / 2)));
      /* It ends in the gap before the exhibit: fade it out there rather than cut it. */
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 10rem), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 10rem), transparent);
    }
  }
  .aa-hero-field > * {
    position: absolute;
    inset: 0;
  }
  /* The glow (site v5 PR 1b): the accent, plainly visible. A cobalt bloom above and behind the headline, a deeper one
     low on the side toward the exhibit, and a wash joining them. Behind text it stays at or under 22% of the accent
     on the page (the lead's ink-2 keeps 6.4:1); it is strongest where there is no text, at the field's edges. */
  .aa-hf-glow {
    background:
      radial-gradient(ellipse 34% 30% at calc(var(--hf-x) - 22%) calc(var(--hf-y) - 26%), color-mix(in srgb, var(--aa-accent) 34%, transparent) 0%, transparent 100%),
      radial-gradient(ellipse 40% 36% at calc(var(--hf-x) + 30%) calc(var(--hf-y) + 30%), color-mix(in srgb, var(--aa-accent-deep) 30%, transparent) 0%, transparent 100%),
      radial-gradient(ellipse 58% 52% at var(--hf-x) var(--hf-y), color-mix(in srgb, var(--aa-accent) 18%, transparent) 0%, color-mix(in srgb, var(--aa-accent) 8%, transparent) 55%, transparent 100%);
  }
  @media (max-width: 68.6875rem) {
    .aa-hf-glow {
      /* Stacked, the bloom sits behind the headline's top and the deeper light below the statement, toward the
         exhibit; both reach past the screen's sides. */
      background:
        radial-gradient(ellipse 70% 26% at 18% 12%, color-mix(in srgb, var(--aa-accent) 32%, transparent) 0%, transparent 100%),
        radial-gradient(ellipse 80% 24% at 86% 92%, color-mix(in srgb, var(--aa-accent-deep) 28%, transparent) 0%, transparent 100%),
        radial-gradient(ellipse 90% 60% at 50% 45%, color-mix(in srgb, var(--aa-accent) 14%, transparent) 0%, transparent 100%);
    }
  }
  /* Graph paper: 24px minor lines, every fourth line a little stronger, and a dot on each crossing. The lines are
     anchored to the frame's left edge, so they meet the frame line exactly. */
  .aa-hf-grid {
    --hf-origin: calc(var(--aa-gutter) + max(0px, (100vw - var(--aa-container)) / 2));
    background-image:
      radial-gradient(circle at 0.5px 0.5px, color-mix(in srgb, var(--aa-rule-strong) 55%, transparent) 0.9px, transparent 1.3px),
      linear-gradient(to right, var(--aa-rule) 1px, transparent 1px),
      linear-gradient(to bottom, var(--aa-rule) 1px, transparent 1px),
      linear-gradient(to right, var(--aa-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--aa-grid) 1px, transparent 1px);
    background-size:
      var(--aa-grid-size) var(--aa-grid-size),
      calc(4 * var(--aa-grid-size)) calc(4 * var(--aa-grid-size)),
      calc(4 * var(--aa-grid-size)) calc(4 * var(--aa-grid-size)),
      var(--aa-grid-size) var(--aa-grid-size),
      var(--aa-grid-size) var(--aa-grid-size);
    background-position: var(--hf-origin) 0;
    -webkit-mask-image: var(--hf-mask);
    mask-image: var(--hf-mask);
  }
  @media (max-width: 68.6875rem) {
    .aa-hf-grid {
      /* Stacked, the field is centred on the screen: so is the paper. */
      background-position: center 0;
    }
  }
  /* The net: calmer where the headline and lead are, full strength in a ring around them, gone at the edges. */
  .aa-hf-net {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms var(--aa-ease);
    -webkit-mask-image: radial-gradient(ellipse 62% 66% at var(--hf-x) var(--hf-y), rgb(0 0 0 / 0.4) 0%, rgb(0 0 0 / 0.4) 24%, #000 52%, transparent 94%);
    mask-image: radial-gradient(ellipse 62% 66% at var(--hf-x) var(--hf-y), rgb(0 0 0 / 0.4) 0%, rgb(0 0 0 / 0.4) 24%, #000 52%, transparent 94%);
  }
  .aa-hero-field.is-live .aa-hf-net {
    opacity: 1;
  }
