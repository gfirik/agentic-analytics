---
// A figure from the recorded run, followed by its fact-ID chip (DESIGN.md §6). The chip links to the fact's row in
// this page's fact ledger (<FactLedger />), so it works without JS. A test checks the ledger lists every chip.
import { fact, factText } from "./data.ts";

interface Props {
  id: string;
  /** Show only the chip, not the value (when the sentence already says the value in words). */
  chip?: boolean;
}
const { id, chip = false } = Astro.props;
const f = fact(id);
---
{!chip && <span class="aa-fig">{factText(id)}</span>}<a
  class="aa-chip"
  href={`#fact-${id}`}
  aria-label={`${id}${f.verified ? ", verified" : ""}: how this number was computed`}
  >{
    f.verified && (
      <svg class="aa-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"
        ><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        ></path></svg
      >
    )
  }{id}</a
>
