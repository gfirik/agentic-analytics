---
// An unnumbered margin note (DESIGN.md §7): in the margin column beside its line from 1000px; under 1000px a small ⊕
// toggles it inline (a real checkbox, so it works without JS). Keep the content inline.
import { nextNote } from "./notes.ts";

const id = `aa-mn-${nextNote(Astro.locals as Record<string, unknown>, "margin")}`;
---

<span class="aa-sn aa-mn"
  >&#8288;<input type="checkbox" id={id} class="aa-sn-toggle" /><label for={id} class="aa-sn-ref aa-mn-ref" title="Margin note"
    ><span class="aa-sr">Margin note</span><span aria-hidden="true">⊕</span></label
  ><span class="aa-sn-note" role="note"><slot /></span></span
>
