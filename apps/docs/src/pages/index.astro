---
// The landing page (DESIGN.md §4–§6): the cover sheet of an audited working paper. One long 1440px frame of wide
// rows (site v4), the hero field (site v5) and graph paper behind the section heads, one live exhibit, and four sections. Every
// figure comes from generated data: the recorded engine run on examples/coffee-roaster (src/data/exhibit.json,
// landing.json, and the pipeline scene's docs/assets/readme/pipeline.json) and the committed eval results
// (src/data/evals.json, scored by the eval runner's summarize()). Nothing is typed by hand.
import pipeline from "../../../../docs/assets/readme/pipeline.json";
import { percent } from "../components/format.ts";
import type { PipelineData } from "../components/pipeline-scene.ts";
import BaseLayout from "../components/site/BaseLayout.astro";
import EngineMachine from "../components/site/EngineMachine.astro";
import Exhibit from "../components/site/Exhibit.astro";
import { machineStations } from "../components/site/engine-machine.ts";
import { firstSentence, type LinePart, placeholders } from "../components/site/exhibit.ts";
import HeroField from "../components/site/HeroField.astro";
import PipelineStages from "../components/site/PipelineStages.astro";
import Reveal from "../components/site/Reveal.astro";
import SectionLabel from "../components/site/SectionLabel.astro";
import StatusStrip from "../components/site/StatusStrip.astro";
import { DOCS_HOME, GITHUB_URL, RELEASES_URL, withBase } from "../components/site/site.ts";
import evals from "../data/evals.json";
import exhibit from "../data/exhibit.json";

interface Bar {
  metric: string;
  value: number | null;
  bar: string;
  pass: boolean | null;
}
interface Suite {
  file: string;
  model: string;
  date: string;
  datasets: number;
  completed: number;
  /** Generated by generate.ts with the eval runner's runStatus (suiteRunLabels): null for a complete run. */
  status: "complete" | "resuming" | "partial";
  flag: string | null;
  bars: Bar[];
}
const COUNT_METRICS = new Set(["Number mismatches"]);
const show = (b: Bar | undefined) =>
  b?.value === null || b?.value === undefined ? "n/a" : COUNT_METRICS.has(b.metric) ? String(b.value) : percent(b.value);
// The seven headline bars, including every bar the smoke run misses (cause grade, recommendation relevance): "results,
// as they are". The rest (quality-issue recall, definition adherence, grounding, jobs completed) are in RESULTS.md.
const METRICS = [
  "Planted recall@5",
  "Distractor FP rate",
  "Driver accuracy",
  "Cause grade accuracy",
  "Citation precision",
  "Recommendation relevance",
  "Number mismatches",
];
const bar = (s: Suite, metric: string) => s.bars.find((b) => b.metric === metric);
const model = (m: string) => m.replace(/^openai-compatible:groq:/, "").replace(/ \(small-model mode\)$/, "");
const synthetic = evals.synthetic as Suite;
const smoke = evals.smoke as Suite;
const full = evals.full as Suite;
// Metrics are rows and runs are columns (site v3, finding 2), so the table fits the container with no sideways
// scroll. Proven results first (the real public data, then the real-model smoke run); the generated-business suite is
// the nightly regression check, and the offline baseline only checks the harness.
const runs = [
  { run: "Free-tier model, smoke", note: `${model(smoke.model).split(" planner")[0]} on Groq, small-model mode`, suite: smoke },
  { run: "Nightly regression", note: `${full.datasets} generated businesses, same roles, over up to two nights`, suite: full },
  { run: "Offline baseline", note: "scripted heuristic, no LLM: checks the harness", suite: synthetic },
];
const realChecks = evals.real.datasets.flatMap((d) => d.checks);
const realPassed = realChecks.filter((c) => c.pass).length;
const sources = [evals.real.file, smoke.file, full.file, synthetic.file];

// §2's three proofs, each with one real example from the same run.
const notes = (
  exhibit as unknown as { notes: Record<string, { id: string; value: string; quote?: string; label: string; sql?: string[] }> }
).notes;
const headline = notes[pipeline.change.pct.id];
// §2's first cell: the report's first sentence as the model wrote it (placeholders) and as the reader sees it.
const sentence = firstSentence((exhibit as unknown as { lines: LinePart[][] }).lines[0] ?? []);
const cause = Object.values(notes).find((n) => n.quote);
const metric = pipeline.metric;
// The metric's compiled SQL, two lines from the first SQL fact's recorded query (landing-data.ts exhibitData()).
const compiled = (exhibit as unknown as { compiled: { fact: string; lines: string[] } }).compiled;

const check = `<svg class="aa-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
// The primary action's trailing arrow (DESIGN.md §6, buttons): a 14px stroke that steps forward on hover.
const arrow = `<svg class="aa-button-arrow" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path></svg>`;
// The hero's proof chips (DESIGN.md §5, site v5 PR 1b): generated by landing-data.ts proofChips() into evals.json from
// the same runs as the status strip and §3, never typed. Each icon is a 16px stroke drawn for its chip.
const proof = (
  evals as unknown as {
    proof: { id: "real" | "numbers" | "verifier" | "local"; figure: string; text: string; href: string; source: string }[];
  }
).proof;
const icon = (d: string) =>
  `<svg viewBox="0 0 16 16" focusable="false"><path d="${d}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
const PROOF_ICONS = {
  // A ledger sheet with a tick: checks run on real data.
  real: icon("M2.5 3.5h11v9h-11zM2.5 6.5h11M6 6.5v6M8 10l1.3 1.2L12 8.6"),
  // An equals sign in a frame: every number recomputed and matching.
  numbers: icon("M2.5 2.5h11v11h-11zM5 6.5h6M5 9.5h6"),
  // A shield with a tick: the verifier's gate.
  verifier: icon("M8 1.8 13 3.6v4.1c0 3-2.1 5.4-5 6.5-2.9-1.1-5-3.5-5-6.5V3.6zM5.8 8l1.5 1.5L10.4 6.4"),
  // A laptop: runs on your own machine.
  local: icon("M3.5 4h9v6h-9zM1.8 12.5h12.4"),
} as const;
// The exhibit's walkthrough steps, for the hero's scroll track (one sentinel each).
const walkSteps = (exhibit as unknown as { walk: { id: string }[] }).walk;
const binaries = ["aa-linux-x64", "aa-linux-arm64", "aa-macos-arm64", "aa-windows-x64.exe", "SHA256SUMS"];
const doors = [
  {
    name: "CLI",
    does: "Analyze files, ask follow-ups, open the working behind any number.",
    cmd: "aa analyze ./exports --open",
    href: "use-it/cli/",
  },
  {
    name: "HTTP API",
    does: "Upload files, stream progress over SSE, fetch the report as JSON or HTML.",
    cmd: "aa serve",
    href: "use-it/http-api/",
  },
  {
    name: "MCP",
    does: "Claude Desktop, Cursor or any MCP client analyzes files and quotes verified numbers.",
    cmd: "aa mcp",
    href: "use-it/mcp/",
  },
  {
    name: "Telegram",
    does: "A demo bot: send files, get the summary and the report back.",
    cmd: "bun run --filter @agentic-analytics/telegram start",
    href: "use-it/telegram/",
  },
];
---

<BaseLayout title="agentic-analytics: an AI analyst you can audit" hero>
  <StatusStrip slot="strip" items={evals.strip} />

  <div class="aa-paper">
    <section class="aa-sheet aa-hero" aria-labelledby="aa-hero-title">
      <div class="aa-cell aa-split aa-hero-row">
        <div class="aa-hero-corners" aria-hidden="true"></div>
        <div class="aa-statement">
          <p class="aa-label aa-hero-eyebrow"><span class="aa-hero-node" aria-hidden="true"></span>Open source · self-hosted</p>
          <h1 id="aa-hero-title" class="aa-hero-title">
            <span class="aa-hero-title-sans">An AI analyst</span>
            <span class="aa-hero-title-serif">you can audit.</span>
          </h1>
          <p class="aa-lead">
            Give it a business's spreadsheets, PDFs and emails. It reports what changed, why, and what to do next, and every number is recomputed
            and every claim cited before you see it.
          </p>
          <div class="aa-actions">
            <a class="aa-button aa-button-primary" href={withBase("start/quickstart/")}>Quickstart<Fragment set:html={arrow} /></a>
            <a class="aa-button aa-button-secondary" href={withBase(DOCS_HOME)}>Read the docs</a>
            <a class="aa-text-link" href={GITHUB_URL}>GitHub</a>
          </div>
          <ul class="aa-hero-proof" aria-label="Proof, from the latest runs">
            {
              proof.map((c) => (
                <li>
                  <a class="aa-pchip" href={c.href.startsWith("#") ? c.href : withBase(c.href)} title={c.source} data-proof={c.id}>
                    <span class="aa-pchip-icon" aria-hidden="true">
                      <Fragment set:html={PROOF_ICONS[c.id]} />
                    </span>
                    {c.figure ? <span class="aa-pchip-figure">{c.figure}</span> : null}
                    <span class="aa-pchip-text">{c.text}</span>
                    <span class="aa-sr">: {c.source}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="aa-hero-cmd-frame">
            <div class="aa-hero-cmd">
              <pre aria-label="Install command"><code>git clone <span class="aa-url">https://github.com/<wbr /><span class="aa-nowrap">{GITHUB_URL.replace("https://github.com/", "")}</span></span>
cd agentic-analytics && bun install</code></pre>
            </div>
          </div>
          <HeroField />
        </div>
        <div class="aa-hero-exhibit">
          <p class="aa-label aa-exhibit-label">Exhibit · a real report from the example run, verified</p>
          <Exhibit />
        </div>
      </div>
      {/* The scroll track the pinned hero stays over (site v5 PR 2; only when the walkthrough is pinned): one sentinel
          per step, which the exhibit's script observes, and a tail so the last step holds before the whole hero
          releases into the engine machine below. The pinned row covers it the whole time, so it never shows. */}
      <div class="aa-hero-track" aria-hidden="true">
        {walkSteps.map((_, i) => <div class="aa-hero-step" data-walk-sentinel={i + 1} />)}
      </div>
    </section>

    <section id="engine" class="aa-sheet aa-engine-band" aria-labelledby="aa-engine-title">
      <div class="aa-cell">
        <div class="aa-cell-head aa-grid-field aa-engine-head">
          <SectionLabel text="The engine, opened up" />
          <h2 id="aa-engine-title" class="aa-h2 aa-center">A small factory for business questions.</h2>
          <p class="aa-lead aa-center">
            {machineStations(pipeline as unknown as PipelineData).length} stations, from your files to a checked report. The models work behind glass;
            every number is made by the database.
          </p>
        </div>
        <EngineMachine />
      </div>
    </section>

    <section id="how" class="aa-sheet" data-reveal aria-labelledby="aa-how-title">
      <div class="aa-cell aa-split">
        <div class="aa-cell-head aa-grid-field">
          <SectionLabel n={1} text="How it works" />
          {/* Site v5 PR 2: the machine above says what each station does, so this head no longer repeats "files in, a
              checked report out"; it says what these panels add: what one run's stages actually produced. */}
          <h2 id="aa-how-title" class="aa-h2 aa-center">What one run produced, stop by stop.</h2>
          <p class="aa-lead aa-center">The files it read, the SQL it ran, the figures and the checks, from the same run.</p>
        </div>
        <div class="aa-how">
          <PipelineStages draw />
        </div>
      </div>
    </section>

    <section id="why" class="aa-sheet" data-reveal aria-labelledby="aa-why-title">
      <div class="aa-cell aa-split">
        <div class="aa-cell-head aa-grid-field">
          <SectionLabel n={2} text="Why it's different" />
          <h2 id="aa-why-title" class="aa-h2 aa-center">Built so you don't have to take its word for it.</h2>
          <p class="aa-lead aa-center">Three rules the engine can't break.</p>
        </div>
        <ul class="aa-proofs">
          <li class="aa-proof">
            <p class="aa-label">01 · Arithmetic</p>
            <h3 class="aa-h3">The model never does arithmetic</h3>
            <p>The model writes placeholders; every figure is a fact computed by SQL or a deterministic function, then recomputed.</p>
            <div class="aa-proof-ex">
              <p class="aa-label aa-proof-cap">The model writes</p>
              <code class="aa-proof-raw">{placeholders(sentence)}</code>
              <p class="aa-label aa-proof-cap">You read</p>
              <p class="aa-proof-out">
                {
                  sentence.map((p) =>
                    p.fact ? (
                      <span class="aa-num"><span class="aa-fig">{notes[p.fact]?.value ?? p.fact}</span><a
                          class="aa-chip"
                          href={`#fact-${p.fact}`}
                          aria-label={`${p.fact}, verified`}><Fragment set:html={check} />{p.fact}</a></span>
                    ) : (
                      p.text
                    ),
                  )
                }
              </p>
            </div>
            <a class="aa-more" href={withBase("how-it-works/pipeline/")}>The pipeline</a>
          </li>
          <li class="aa-proof">
            <p class="aa-label">02 · Definitions</p>
            <h3 class="aa-h3">Definitions you confirm</h3>
            <p>Each metric is drafted in plain words and YAML before anything is measured. You accept, edit or drop it.</p>
            <div class="aa-proof-ex">
              <p class="aa-proof-def">
                <code>{metric.id}</code>: {metric.formula}, per {metric.grain} · {metric.status} · compiles to
              </p>
              <pre class="aa-proof-code"><code>{compiled.lines.join("\n")}</code></pre>
            </div>
            <a class="aa-more" href={withBase("how-it-works/metrics/")}>The metric layer</a>
          </li>
          <li class="aa-proof">
            <p class="aa-label">03 · Citations</p>
            <h3 class="aa-h3">Every claim is cited</h3>
            <p>Causes come from your documents, quoted exactly and checked against the source, and graded by how strong they are.</p>
            <div class="aa-proof-ex">
              {
                cause ? (
                  <p class="aa-proof-example">
                    <q>{cause.quote}</q>{" "}
                    <a class="aa-chip" href={`#source-${cause.id}`} aria-label={`${cause.id}, checked`}>
                      <Fragment set:html={check} />
                      {cause.id}
                    </a>
                    <span class="aa-proof-src">{cause.label}</span>
                  </p>
                ) : null
              }
            </div>
            <a class="aa-more" href={withBase("how-it-works/verifier/")}>The verifier</a>
          </li>
        </ul>
      </div>
    </section>

    <section id="results" class="aa-sheet" data-reveal aria-labelledby="aa-results-title">
      <div class="aa-cell aa-band">
        <div class="aa-cell-head aa-grid-field">
          <SectionLabel n={3} text="Results, as they are" />
          <h2 id="aa-results-title" class="aa-h2 aa-center">Measured, with the caveats next to the numbers.</h2>
          <p class="aa-lead aa-center">Real public data first; a run with jobs missing is labelled, not hidden.</p>
        </div>
        <div class="aa-results-body">
          <div class="aa-ledger-wrap" role="region" aria-label="Eval results" tabindex="0">
            <table class="aa-ledger aa-results">
              <thead>
                <tr>
                  <th scope="col">Metric · bar</th>
                  <th scope="col" id="aa-run-real">
                    <span class="aa-run">Real public data</span>
                    <span class="aa-run-note">{evals.real.datasets.length} datasets, checked against SQL written separately</span>
                    <span class="aa-run-meta">
                      <span class="aa-run-count">
                        {evals.real.datasets.filter((d) => d.completed).length}/{evals.real.datasets.length}
                      </span>{" "}
                      jobs · {evals.real.date}
                    </span>
                  </th>
                  {
                    runs.map((c, k) => (
                      <th scope="col" id={`aa-run-${k}`}>
                        <span class="aa-run">{c.run}</span>
                        <span class="aa-run-note">{c.note}</span>
                        <span class="aa-run-meta">
                          <span class="aa-run-count">
                            {c.suite.completed}/{c.suite.datasets}
                          </span>{" "}
                          jobs · {c.suite.date}
                        </span>
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  METRICS.map((m, i) => (
                    <tr>
                      <th scope="row">
                        <span class="aa-metric">{m}</span>
                        <span class="aa-th-sub">bar {bar(synthetic, m)?.bar}</span>
                      </th>
                      {i === 0 ? (
                        <td rowspan={METRICS.length} class="aa-span" headers="aa-run-real">
                          <span class="aa-fig">
                            {realPassed}/{realChecks.length}
                          </span>{" "}
                          checks against SQL written separately
                          {realPassed === realChecks.length ? <Fragment set:html={` ${check}<span class="aa-sr">all pass</span>`} /> : null}
                          <span class="aa-span-note">Scored by its own checks instead: real files have no planted events.</span>
                        </td>
                      ) : null}
                      {runs.map((c, k) => {
                        // A run with jobs missing gets one cell over all its metric rows, labelled from the generated
                        // data (the runner's runStatus): partial after its last pass, in progress between passes.
                        const { flag, status, completed, datasets } = c.suite;
                        if (flag)
                          return i === 0 ? (
                            <td rowspan={METRICS.length} class="aa-span" headers={`aa-run-${k}`}>
                              <span class={status === "resuming" ? "aa-in-progress" : "aa-partial"}>{flag}</span>
                              <span class="aa-fig">
                                {completed}/{datasets}
                              </span>{" "}
                              jobs finished
                              <span class="aa-span-note">
                                {status === "resuming"
                                  ? "Rates are shown if every job finishes by its last pass."
                                  : "Rates not shown: unfinished jobs would count as misses."}
                              </span>
                            </td>
                          ) : null;
                        const b = bar(c.suite, m);
                        return (
                          <td class="num">
                            <span class="aa-fig">{show(b)}</span>
                            {b?.pass === true ? (
                              <span class="aa-verified">
                                <Fragment set:html={check} />
                                <span class="aa-sr">meets the bar</span>
                              </span>
                            ) : b?.pass === false ? (
                              <span class="aa-below">below bar</span>
                            ) : null}
                          </td>
                        );
                      })}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="aa-small aa-under">
            Real public data is checked against SQL written separately; a free-tier model then runs the smoke suite. The generated businesses
            with planted events are the nightly regression check, run over up to two nights within the free tier's quota; the latest published
            run is shown, labelled partial only if jobs are still unfinished after its second night. The offline baseline is a scripted
            heuristic tuned on the same datasets, so its scores are optimistic: it tests the engine and the harness, not model quality. <a href={withBase("quality/results/")}>All results (RESULTS.md)</a> ·{" "}
            <a href={withBase("quality/evals/")}>How quality is measured</a>
          </p>
          <details class="aa-sources">
            <summary>Sources: {sources.length} result files</summary>
            <ul>{sources.map((f) => <li><code>{f}</code></li>)}</ul>
          </details>
        </div>
      </div>
    </section>

    <section id="quickstart" class="aa-sheet" data-reveal aria-labelledby="aa-quick-title">
      <div class="aa-cell aa-split aa-quick-row">
        <div class="aa-cell-head aa-grid-field">
          <SectionLabel n={4} text="Quickstart" />
          <h2 id="aa-quick-title" class="aa-h2 aa-center">Run it on the example, then on your files.</h2>
          <p class="aa-lead aa-center">Install, pick a free model, analyze the example.</p>
        </div>
        <ol class="aa-steps">
          <li class="aa-step">
            <p class="aa-label">Step 1 · Install</p>
            <div class="aa-code">
              <pre tabindex="0" aria-label="Install"><code>git clone \
  <span class="aa-url">https://github.com/<wbr /><span class="aa-nowrap">gfirik/agentic-analytics</span></span>
cd agentic-analytics
bun install
bun run aa doctor</code></pre>
            </div>
            <p class="aa-small">Node 22 and Bun. <code>doctor</code> says what this machine has.</p>
          </li>
          <li class="aa-step">
            <p class="aa-label">Step 2 · Model</p>
            <div class="aa-code">
              <pre tabindex="0" aria-label="Choose a model"><code><span class="c"># Ollama, or a free endpoint in .env</span>
cp .env.example .env</code></pre>
            </div>
            <p class="aa-small">
              Free and local only: Ollama or a free OpenAI-compatible endpoint. <a href={withBase("models/running-free/")}>Running free</a>
            </p>
          </li>
          <li class="aa-step">
            <p class="aa-label">Step 3 · Analyze</p>
            <div class="aa-code">
              <pre tabindex="0" aria-label="Analyze the example"><code>bun run aa analyze \
  examples/coffee-roaster --open
<span class="c"># no model yet? replay it offline</span>
AA_DEMO_MODEL=scripted \
  bun run aa analyze \
  examples/coffee-roaster \
  --yes --embedder hash</code></pre>
            </div>
            <p class="aa-small">The report opens with every number linked to its working.</p>
          </li>
        </ol>
          <div class="aa-quick-bins">
            <p class="aa-label">Standalone binaries · Docker</p>
            <p class="aa-small">
              No Node or Bun needed: attached to each tagged release, from v0.1.0 on, with a checksum file. <a href={RELEASES_URL}
                >Releases</a
              >
            </p>
            <ul class="aa-binaries">{binaries.map((b) => <li><code>{b}</code></li>)}</ul>
            <p class="aa-small"><code>docker compose up</code> · API, viewer and MCP on <code>http://127.0.0.1:8080</code></p>
          </div>
          <div class="aa-quick-doors">
            <p class="aa-label">Four doors, one engine</p>
            <ul class="aa-doors">
              {
                doors.map((d) => (
                  <li>
                    <a class="aa-door-name" href={withBase(d.href)}>
                      {d.name}
                    </a>
                    <span class="aa-door-does">{d.does}</span>
                    <code class="aa-door-cmd">{d.cmd.split(" ").flatMap((w, i) => (i ? [" ", <span class="aa-nowrap">{w}</span>] : [<span class="aa-nowrap">{w}</span>]))}</code>
                  </li>
                ))
              }
            </ul>
          </div>
      </div>
    </section>
  </div>
  <Reveal />
</BaseLayout>

<style>
  /* The frame (site v4): one long vertical frame, 1px rules left and right of the 1440px container, sections divided by
     full-bleed hairlines that meet it, a small + where they cross. Under 45rem the side rules would sit on the screen
     edge, so only the hairlines remain. */
  /* The "+" ticks sit half outside the frame; where the frame meets the screen edge (up to 1440px) that would scroll
     the page sideways, so the paper clips them (clip, not hidden: no scroll container, so sticky still works). The
     graph paper's full-bleed field is clipped the same way. */
  .aa-paper {
    overflow-x: clip;
  }
  .aa-sheet {
    border-top: 1px solid var(--aa-rule);
  }
  .aa-sheet:first-child {
    border-top: 0;
  }
  .aa-cell {
    position: relative;
    max-width: var(--aa-container);
    margin: 0 auto;
    padding: var(--aa-space-8) var(--aa-gutter);
    border-inline: 1px solid var(--aa-rule);
  }
  .aa-sheet {
    position: relative;
  }
  .aa-sheet::before,
  .aa-sheet::after {
    content: "+";
    position: absolute;
    top: -0.56rem;
    z-index: 2;
    font: 400 1rem / 1 var(--aa-font-mono);
    color: var(--aa-rule-strong);
    pointer-events: none;
  }
  .aa-sheet::before {
    left: calc(max(0px, (100% - var(--aa-container)) / 2) - 0.3rem);
  }
  .aa-sheet::after {
    right: calc(max(0px, (100% - var(--aa-container)) / 2) - 0.3rem);
  }
  .aa-sheet:first-child::before,
  .aa-sheet:first-child::after {
    content: none;
  }

  /* Graph paper behind the hero statement and the section heads only (decorative), full-bleed: it runs out to the
     screen's edges and fades to the plain page through a CSS mask. It sits under the content, never behind the visuals
     or long text. Stacked (under 1100px) a head is centred, so its field spans the screen's width over the head's
     height; in a wide row the head is the left column, so its field runs from the screen's left edge to the middle of
     the gap before the visual. Its width uses 50vw / 100vw, which include a classic (non-overlay) scrollbar's width,
     so the field can reach a few pixels past the viewport: .aa-paper's overflow-x: clip hides that, and the
     no-sideways-scroll browser tests hold with it. */
  .aa-grid-field {
    position: relative;
    isolation: isolate;
  }
  .aa-grid-field::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--aa-space-8)) calc(50% - 50vw) calc(-1 * var(--aa-space-5));
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--aa-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--aa-grid) 1px, transparent 1px);
    background-size: var(--aa-grid-size) var(--aa-grid-size);
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 65% 70% at 50% 45%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 65% 70% at 50% 45%, #000 35%, transparent 100%);
    pointer-events: none;
  }

  /* Wide rows (site v4): from 1100px a section is one row of two columns, the text on the left (its 56ch measure) and
     a large visual on the right; below that they stack, the head centred above its visual. */
  .aa-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--aa-space-7);
  }
  .aa-split > * {
    min-width: 0;
  }
  @media (min-width: 68.75rem) {
    .aa-split {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--aa-space-8);
      align-items: start;
    }
    .aa-split > .aa-grid-field::before {
      /* From the screen's left edge (past the gutter and the margin outside the frame) to the middle of the gap. */
      inset: calc(-1 * var(--aa-space-8)) calc(-1 * var(--aa-space-6))
        calc(-1 * var(--aa-space-8)) calc(-1 * (var(--aa-gutter) + max(0px, (100vw - var(--aa-container)) / 2)));
      -webkit-mask-image: radial-gradient(ellipse 70% 75% at 62% 45%, #000 30%, transparent 100%);
      mask-image: radial-gradient(ellipse 70% 75% at 62% 45%, #000 30%, transparent 100%);
    }
  }

  /* Hero: the statement on the left and the exhibit's report page on the right from 1100px, so the verification replay
     plays on the first screen; stacked and centred below that. The right column is wide enough at 1440 (about 795px)
     for the exhibit's notes to sit beside it (its container query, Exhibit.astro). Site v5: the statement stands on
     its own field (HeroField.astro: graph paper, glow, grain and the drifting net), inside framed corner marks, with a
     tighter type scale: the eyebrow as a quiet tag, the headline set close, the lead a step larger. */
  .aa-statement {
    position: relative;
    isolation: isolate;
    container-type: inline-size; /* the field centres its glow on the statement with cqi */
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    align-content: start;
    text-align: center;
  }
  /* The headline in two voices (site v5 PR 1b): the claim in Plex Sans at 700, set tight, and the promise in the
     serif italic a touch larger so its lighter strokes carry the same weight on the line. One size token for both
     (--aa-text-hero: 44px on phones, 81px at 1440, 84px wider). */
  .aa-hero-title {
    display: grid;
    justify-items: inherit;
    margin: var(--aa-space-5) 0 0;
    /* Never wider than the statement: each voice is one line, about 6.2em at most, so the size also keeps under
       16% of the statement's width (cqi; at 1100 the column is about 400px). */
    font-size: min(var(--aa-text-hero), 16cqi);
    color: var(--aa-ink);
    white-space: nowrap;
  }
  .aa-hero-title-sans {
    font: 700 1em / 1 var(--aa-font-sans);
    letter-spacing: -0.04em;
  }
  .aa-hero-title-serif {
    font: italic 400 1.06em / 1.06 var(--aa-font-display);
    font-optical-sizing: auto;
    letter-spacing: -0.02em;
    padding-right: 0.06em; /* the italic's last stroke leans past its box */
  }
  .aa-statement > .aa-lead {
    margin-top: var(--aa-space-5);
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .aa-statement > .aa-actions {
    margin-top: var(--aa-space-6);
  }
  .aa-statement > .aa-hero-proof {
    margin-top: var(--aa-space-5);
  }
  .aa-statement > .aa-hero-cmd-frame {
    margin-top: var(--aa-space-5);
  }
  /* Proof chips (site v5 PR 1b): what the headline claims, as figures from the latest runs (evals.json "proof"). Hairline
     tags on the raised sheet like the eyebrow, each led by its icon in an accent well; the figure in mono. They wrap
     as whole chips, so the row's height never depends on a word breaking. */
  .aa-hero-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--aa-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aa-pchip {
    display: inline-flex;
    align-items: center;
    gap: var(--aa-space-2);
    min-height: 2rem;
    padding: 0 var(--aa-space-3) 0 0.25rem;
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
    background: var(--aa-raised);
    font: 500 0.8125rem / 1 var(--aa-font-sans);
    color: var(--aa-ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--aa-fast) var(--aa-ease),
      color var(--aa-fast) var(--aa-ease);
  }
  .aa-pchip:hover {
    border-color: var(--aa-ink);
    color: var(--aa-ink);
  }
  .aa-pchip-icon {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    border-radius: 3px;
    background: var(--aa-surface);
    color: var(--aa-ink);
  }
  .aa-pchip-icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .aa-pchip-figure {
    font: 500 0.8125rem / 1 var(--aa-font-mono);
    color: var(--aa-ink);
  }
  /* From 480px the four sit in two even columns, a tidy block under the actions; narrower they wrap as whole chips. */
  @media (min-width: 30rem) {
    .aa-hero-proof {
      display: grid;
      grid-template-columns: repeat(2, max-content);
      justify-content: center;
    }
    .aa-hero-proof > li {
      display: grid;
    }
  }
  @media (max-width: 29.9375rem) {
    .aa-hero-proof {
      gap: 0.375rem;
    }
    .aa-pchip {
      gap: 0.375rem;
      padding-right: var(--aa-space-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aa-pchip {
      transition: none;
    }
  }
  @media (min-width: 40rem) {
    .aa-statement > .aa-lead {
      font-size: 1.25rem;
      line-height: 1.55;
    }
  }
  /* The eyebrow: a label in a hairline tag on the raised sheet, led by the net's own square node. */
  .aa-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--aa-space-2);
    padding: var(--aa-space-1) var(--aa-space-3);
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius-chip);
    background: var(--aa-raised);
    text-align: left;
  }
  /* The tag stays one line down to 320px (site v5 PR 1b): "free local models" moved to a proof chip, which carries
     its source, so the tag no longer wrapped "MODELS" onto a line of its own at 390. */
  .aa-hero-eyebrow {
    white-space: nowrap;
  }
  .aa-hero-node {
    width: 6px;
    height: 6px;
    flex: none;
    background: var(--aa-ink);
  }
  /* Framed corner marks at the hero's four corners, inside the frame: 12px arms in rule-strong, drawn as eight
     background strokes on one box (no extra elements, nothing to lay out). */
  .aa-hero-corners {
    --c: var(--aa-rule-strong);
    --arm: 12px;
    position: absolute;
    inset: var(--aa-space-4);
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(var(--c), var(--c)) left top / var(--arm) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) left top / 1px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) right top / var(--arm) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) right top / 1px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) left bottom / var(--arm) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) left bottom / 1px var(--arm) no-repeat,
      linear-gradient(var(--c), var(--c)) right bottom / var(--arm) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) right bottom / 1px var(--arm) no-repeat;
  }
  @media (max-width: 29.9375rem) {
    .aa-hero-corners {
      inset: var(--aa-space-2);
      --arm: 8px;
    }
  }
  .aa-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--aa-space-3);
  }
  .aa-text-link {
    font: 500 0.9375rem / 1 var(--aa-font-sans);
    padding: 0 var(--aa-space-2);
  }
  /* Two fixed lines (clone, then cd and install) in a hairline box that scrolls sideways on narrow screens: its height
     never depends on when the mono face arrives (a wrapping line re-wrapped on the swap and moved the page, M13k),
     and at 1440 the statement column shows both lines whole (one line was cut mid-word there). */
  /* The frame (hairline, raised) stays put while the line inside scrolls and fades at its edges. */
  .aa-hero-cmd-frame {
    max-width: 100%;
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
    background: var(--aa-raised);
  }
  .aa-hero-cmd {
    margin: 0;
    padding: 0.625rem 0.875rem;
    overflow-x: auto;
    text-align: left;
  }
  /* The install line wraps instead of scrolling (site v5 PR 2: at 390 the clone URL was cut off at the box's edge):
     the URL only after "github.com/" (the <wbr>), and as an inline block its second line starts under its first, so it
     reads as one argument. "10ch" is "git clone " only while the span inherits the pre's mono face and size. */
  .aa-hero-cmd pre {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: normal;
  }
  .aa-hero-cmd .aa-url {
    display: inline-block;
    max-width: calc(100% - 10ch);
    vertical-align: top;
  }
  .aa-hero-cmd .aa-nowrap {
    white-space: nowrap;
  }
  .aa-hero-cmd code {
    font: 400 var(--aa-text-code) / 1.6 var(--aa-font-mono);
    color: var(--aa-ink-2);
  }
  .aa-hero-row {
    padding-bottom: var(--aa-space-8);
  }
  .aa-hero-exhibit {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .aa-exhibit-label {
    margin-bottom: var(--aa-space-4);
  }
  /* The scroll-driven walkthrough (site v5 PR 2; DESIGN.md §5–§6, overriding D2's "nothing pinned"). From 1100px, when
     the whole hero fits the screen (Exhibit.astro decides before first paint: data-walk="pin"), the hero's row (the
     statement, its field and the exhibit, inside the frame's corner marks) is one sticky unit, at least a screen tall
     with its content centred, over a scroll track below it in the section: each sentinel crossing a line 65% down the
     screen is the next step. The row covers the track the whole time, and as the track ends the whole hero releases
     straight into the engine machine's band, with nothing in between. Below that (stacked, or a short window), under
     reduced motion and without JS there is no track. Position only: nothing animates. */
  .aa-hero {
    --aa-walk-step: 45vh;
    timeline-scope: --aa-walk-track;
  }
  .aa-hero-track {
    display: none;
  }
  .aa-hero:has([data-walk="pin"]) > .aa-hero-track {
    display: block;
    /* The tail: the last step holds for a while before the pin lets go. */
    padding-bottom: 20vh;
    view-timeline: --aa-walk-track block;
  }
  .aa-hero-step {
    height: var(--aa-walk-step);
  }
  .aa-hero:has([data-walk="pin"]) > .aa-hero-row {
    position: sticky;
    top: 0;
    z-index: 1;
    /* At least a screen tall, so the empty track never shows below it, with the content centred so a tall screen
       (1920 × 1080) has no empty block at the bottom; the statement's field fades in at its top while pinned
       (HeroField.astro), so its edge never shows mid-screen. */
    min-height: 100vh;
    min-height: 100svh;
    align-content: center;
  }
  @media (min-width: 68.75rem) {
    .aa-hero-row {
      gap: var(--aa-space-7);
    }
    /* The eyebrow's top lines up with the exhibit's label across the gap. */
    .aa-statement {
      justify-items: start;
      text-align: left;
    }
    .aa-hero-eyebrow {
      margin-top: calc(-1 * var(--aa-space-1) - 1px);
    }
    .aa-actions,
    .aa-hero-proof {
      justify-content: flex-start;
    }
  }
  /* The pinned hero on laptop screens (site v5 PR 2): the whole hero must fit one screen, down to 680px of viewport
     height (below that the walkthrough is the tap list, Exhibit.astro). Pinned, its frame has no bottom padding (the
     centring already leaves room there), so the release leaves no tall empty strip under the exhibit. From 1280px wide the exhibit column is at least 48rem, so
     its notes sit beside the report page (stacked below it they would not fit). Under 900px of height the statement
     goes compact: the headline also follows the screen's height (min(…, 9svh)), the lead a step down, tighter gaps.
     Sizes only, chosen before first paint with the mode, so nothing shifts; same font faces and weights. */
  @media (min-width: 68.75rem) {
    .aa-hero:has([data-walk="pin"]) > .aa-hero-row {
      padding-block: var(--aa-space-6) 0;
    }
  }
  @media (min-width: 80rem) {
    .aa-hero:has([data-walk="pin"]) > .aa-hero-row {
      grid-template-columns: minmax(0, 1fr) minmax(48rem, 1.9fr);
    }
  }
  @media (min-width: 68.75rem) and (max-height: 56.24rem) {
    .aa-hero:has([data-walk="pin"]) > .aa-hero-row {
      padding-block: var(--aa-space-5) 0;
    }
    .aa-hero:has([data-walk="pin"]) .aa-hero-title {
      margin-top: var(--aa-space-4);
      font-size: min(var(--aa-text-hero), 16cqi, 9svh);
    }
    .aa-hero:has([data-walk="pin"]) .aa-statement > .aa-lead {
      margin-top: var(--aa-space-4);
      font-size: 1.0625rem;
      line-height: 1.5;
    }
    .aa-hero:has([data-walk="pin"]) .aa-statement > .aa-actions {
      margin-top: var(--aa-space-5);
    }
    .aa-hero:has([data-walk="pin"]) .aa-statement > .aa-hero-proof,
    .aa-hero:has([data-walk="pin"]) .aa-statement > .aa-hero-cmd-frame {
      margin-top: var(--aa-space-4);
    }
    .aa-hero:has([data-walk="pin"]) .aa-exhibit-label {
      margin-bottom: var(--aa-space-3);
    }
  }
  /* The engine machine's band (DESIGN.md §6): the head above, then the full-width stage (its own component). */
  .aa-engine-head {
    margin-bottom: var(--aa-space-7);
  }
  .aa-engine-head .aa-lead {
    max-width: var(--aa-measure);
  }
  /* Section heads: the bracketed label on a hairline, a serif heading and lead; centred when stacked, on the left in a
     wide row or band from 1100px, where the label's hairline runs only after it. */
  .aa-cell-head {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--aa-space-4);
    text-align: center;
  }
  .aa-center {
    margin-inline: auto;
  }
  @media (min-width: 68.75rem) {
    .aa-cell-head {
      justify-items: start;
      text-align: left;
    }
    .aa-cell-head .aa-center {
      margin-inline: 0;
    }
    .aa-cell-head :global(.aa-seclabel)::before {
      content: none;
    }
  }

  /* In a wide row the visual is taller than its head, so the head stays in view beside it while the row scrolls by
     (site v4 PR 3). Position only: nothing animates. Only §1 and §2, whose heads are alone in their column: a sticky
     grid item is held within the whole grid, so §4's head would slide over the binaries list below it. A new section joins
     only if its head is alone in its column (the "sticky row head is alone" browser test checks). */
  @media (min-width: 68.75rem) {
    :is(#how, #why) .aa-split > .aa-cell-head {
      position: sticky;
      top: var(--aa-space-7);
    }
  }

  /* §2: three proofs. Stacked under 52rem; three cells side by side to 1100px, their five parts on rows shared across
     the cells (subgrid), so the example boxes line up and match in height (site v3, finding 13); in the wide row, three
     ruled rows, the words on the left and the example on the right. */
  .aa-proofs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--aa-rule);
  }
  .aa-proof {
    display: grid;
    gap: var(--aa-space-3);
    padding: var(--aa-space-6) 0;
  }
  .aa-proof + .aa-proof {
    border-top: 1px solid var(--aa-rule);
  }
  @media (min-width: 52rem) and (max-width: 68.6875rem) {
    .aa-proofs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .aa-proof {
      grid-row: span 5;
      grid-template-rows: subgrid;
      padding: var(--aa-space-6) var(--aa-space-5);
    }
    .aa-proof:first-child {
      padding-left: 0;
    }
    .aa-proof:last-child {
      padding-right: 0;
    }
    .aa-proof + .aa-proof {
      border-top: 0;
      border-left: 1px solid var(--aa-rule);
    }
  }
  @media (min-width: 68.75rem) {
    .aa-proof {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      grid-template-rows: auto auto auto 1fr;
      column-gap: var(--aa-space-6);
    }
    .aa-proof > :not(.aa-proof-ex) {
      grid-column: 1;
    }
    .aa-proof > .aa-proof-ex {
      grid-column: 2;
      grid-row: 1 / span 4;
      align-self: start;
    }
    .aa-proof > .aa-more {
      align-self: end;
    }
  }
  .aa-proofs p:not(.aa-label) {
    color: var(--aa-ink-2);
    font-size: var(--aa-text-small);
  }
  .aa-proof-ex {
    display: grid;
    align-content: start;
    gap: var(--aa-space-2);
    padding: var(--aa-space-3);
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
    background: var(--aa-raised);
  }
  .aa-proofs .aa-proof-ex > * {
    margin: 0;
  }
  .aa-proof-raw {
    display: block;
    font-size: var(--aa-text-code);
    line-height: 1.6;
    color: var(--aa-ink-2);
    overflow-wrap: anywhere;
  }
  .aa-proofs p.aa-proof-out {
    font-size: var(--aa-text-small);
    line-height: 1.75;
    color: var(--aa-ink);
  }
  .aa-proofs .aa-proof-example {
    color: var(--aa-ink);
  }
  .aa-proof-example code {
    font-size: var(--aa-text-code);
  }
  .aa-proof-src {
    display: block;
    margin-top: var(--aa-space-1);
    font: 400 var(--aa-text-label) / 1.4 var(--aa-font-mono);
    color: var(--aa-ink-3);
  }
  .aa-proofs p.aa-proof-def {
    color: var(--aa-ink);
    font-size: var(--aa-text-note);
  }
  .aa-proof-code {
    margin: 0;
    padding: var(--aa-space-3);
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
    background: var(--aa-page);
    font-size: var(--aa-text-code);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .aa-more {
    justify-self: start;
    font-weight: 500;
    font-size: var(--aa-text-small);
  }
  /* Its arrow steps 3px forward on hover (transform only). */
  .aa-more::after {
    content: "→";
    display: inline-block;
    margin-left: 0.3em;
    transition: transform var(--aa-fast) var(--aa-ease);
  }
  .aa-more:hover::after {
    transform: translateX(3px);
  }

  /* Rows take the mark wash under the pointer, in 150ms (§3's metric rows, §4's doors), so the eye can follow a row
     across. A cell spanning every row (a run without rates) stays as it is. */
  .aa-results tbody th,
  .aa-results tbody td:not(.aa-span),
  .aa-doors li {
    transition: background-color var(--aa-fast) var(--aa-ease);
  }
  .aa-results tbody tr:hover > th[scope="row"],
  .aa-results tbody tr:hover > td:not(.aa-span),
  .aa-doors li:hover {
    background-color: var(--aa-mark);
  }

  /* §3: metrics as rows, runs as columns; a run without rates gets one cell over all its rows. */
  .aa-results th[scope="col"] {
    vertical-align: bottom;
    min-width: 11rem;
    white-space: normal;
  }
  .aa-results th[scope="col"]:first-child {
    min-width: 0;
  }
  .aa-results td.num {
    text-align: right;
  }
  .aa-results th[scope="row"] {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--aa-ink);
    font-family: var(--aa-font-sans);
    font-size: var(--aa-text-small);
    border-bottom: 1px solid var(--aa-rule);
    white-space: nowrap;
  }
  .aa-metric {
    display: block;
  }
  .aa-th-sub {
    display: block;
    font: 400 var(--aa-text-label) / 1.4 var(--aa-font-mono);
    color: var(--aa-ink-3);
  }
  .aa-run {
    display: block;
    font: 500 var(--aa-text-small) / 1.4 var(--aa-font-sans);
    letter-spacing: 0;
    text-transform: none;
    color: var(--aa-ink);
  }
  .aa-run-note {
    display: block;
