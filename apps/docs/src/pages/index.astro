---
// The landing page (DESIGN.md §4–§6): the cover sheet of an audited working paper. One long 1440px frame: the hero's
// wide row (site v4) and full-width bands below it (site v5), the hero field (site v5) and graph paper behind the
// section heads, one live exhibit, and four sections. Every figure comes from generated data: the recorded engine run
// on examples/coffee-roaster (src/data/exhibit.json, landing.json, and the pipeline scene's docs/assets/readme/
// pipeline.json) and the committed eval results (src/data/evals.json, scored by the eval runner's summarize()).
// Nothing is typed by hand. Each section is its own component (components/site/landing/); this page composes them
// and owns the frame they share.
import BaseLayout from "../components/site/BaseLayout.astro";
import EngineBand from "../components/site/landing/EngineBand.astro";
import Hero from "../components/site/landing/Hero.astro";
import HowItWorks from "../components/site/landing/HowItWorks.astro";
import Quickstart from "../components/site/landing/Quickstart.astro";
import Results from "../components/site/landing/Results.astro";
import WhyDifferent from "../components/site/landing/WhyDifferent.astro";
import Reveal from "../components/site/Reveal.astro";
import StatusStrip from "../components/site/StatusStrip.astro";
import evals from "../data/evals.json";
---

<BaseLayout title="agentic-analytics: an AI analyst you can audit" hero>
  <StatusStrip slot="strip" items={evals.strip} />

  <div class="aa-paper">
    <Hero />
    <EngineBand />
    <HowItWorks />
    <WhyDifferent />
    <Results />
    <Quickstart />
  </div>
  <Reveal />
</BaseLayout>

<style is:global>
  /* The frame (site v4): one long vertical frame, 1px rules left and right of the 1440px container, sections divided by
     full-bleed hairlines that meet it, a small + where they cross. Under 45rem the side rules would sit on the screen
     edge, so only the hairlines remain. */
  /* The "+" ticks sit half outside the frame; where the frame meets the screen edge (up to 1440px) that would scroll
     the page sideways, so the paper clips them (clip, not hidden: no scroll container, so sticky still works). The
     graph paper's full-bleed field is clipped the same way. */
  .aa-paper {
    overflow-x: clip;
  }
  .aa-sheet {
    border-top: 1px solid var(--aa-rule);
  }
  .aa-sheet:first-child {
    border-top: 0;
  }
  .aa-cell {
    position: relative;
    max-width: var(--aa-container);
    margin: 0 auto;
    padding: var(--aa-space-8) var(--aa-gutter);
    border-inline: 1px solid var(--aa-rule);
  }
  .aa-sheet {
    position: relative;
  }
  .aa-sheet::before,
  .aa-sheet::after {
    content: "+";
    position: absolute;
    top: -0.56rem;
    z-index: 2;
    font: 400 1rem / 1 var(--aa-font-mono);
    color: var(--aa-rule-strong);
    pointer-events: none;
  }
  .aa-sheet::before {
    left: calc(max(0px, (100% - var(--aa-container)) / 2) - 0.3rem);
  }
  .aa-sheet::after {
    right: calc(max(0px, (100% - var(--aa-container)) / 2) - 0.3rem);
  }
  .aa-sheet:first-child::before,
  .aa-sheet:first-child::after {
    content: none;
  }

  /* Full-width bands (site v5): §1–§4 put the head across the top and the content full width below it, the content
     using the width in columns of its own. Beside a tall visual, a head column left a large empty block at every
     scroll position, sticky or not (the "no large empty block" browser test checks). Stacked, a band is the same
     grid as a wide row was: head, then content, a gap apart. */
  .aa-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--aa-space-7);
  }
  .aa-band > * {
    min-width: 0;
  }

  @media (max-width: 45rem) {
    .aa-cell {
      border-inline: 0;
      padding-top: var(--aa-space-7);
      padding-bottom: var(--aa-space-7);
    }
    .aa-sheet::before,
    .aa-sheet::after {
      content: none;
    }
  }
</style>
