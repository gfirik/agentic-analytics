---
// The landing page (DESIGN.md §4–§6): the cover sheet of an audited working paper. One long frame, graph paper behind
// the hero and the section heads, one live exhibit, and four sections. Every figure comes from generated data: the
// recorded engine run on examples/coffee-roaster (src/data/exhibit.json, landing.json, and the pipeline scene's
// docs/assets/readme/pipeline.json) and the committed eval results (src/data/evals.json, scored by the eval runner's
// summarize()). Nothing is typed by hand.
import pipeline from "../../../../docs/assets/readme/pipeline.json";
import { percent } from "../components/format.ts";
import Pipeline from "../components/Pipeline.tsx";
import BaseLayout from "../components/site/BaseLayout.astro";
import Exhibit from "../components/site/Exhibit.astro";
import SectionLabel from "../components/site/SectionLabel.astro";
import StatusStrip from "../components/site/StatusStrip.astro";
import { DOCS_HOME, GITHUB_URL, RELEASES_URL, withBase } from "../components/site/site.ts";
import evals from "../data/evals.json";
import exhibit from "../data/exhibit.json";

interface Bar {
  metric: string;
  value: number | null;
  bar: string;
  pass: boolean | null;
}
interface Suite {
  file: string;
  model: string;
  date: string;
  datasets: number;
  completed: number;
  bars: Bar[];
}
const COUNT_METRICS = new Set(["Number mismatches"]);
const show = (b: Bar | undefined) =>
  b?.value === null || b?.value === undefined ? "n/a" : COUNT_METRICS.has(b.metric) ? String(b.value) : percent(b.value);
const METRICS = ["Planted recall@5", "Distractor FP rate", "Driver accuracy", "Citation precision", "Number mismatches"];
const bar = (s: Suite, metric: string) => s.bars.find((b) => b.metric === metric);
const model = (m: string) => m.replace(/^openai-compatible:groq:/, "").replace(/ \(small-model mode\)$/, "");
const synthetic = evals.synthetic as Suite;
const smoke = evals.smoke as Suite;
const full = evals.full as Suite;
// Proven results first (the real public data row, then the real-model smoke run); the generated-business suite is the
// nightly regression check, and the offline baseline only checks the harness.
const rows = [
  { run: "Free-tier model, smoke", note: `${model(smoke.model).split(" planner")[0]} on Groq, small-model mode`, suite: smoke },
  { run: "Nightly regression", note: `${full.datasets} generated businesses, same roles, one pass a night on the free tier`, suite: full },
  { run: "Offline baseline", note: "scripted heuristic, no LLM: checks the harness", suite: synthetic },
];
const realChecks = evals.real.datasets.flatMap((d) => d.checks);
const realPassed = realChecks.filter((c) => c.pass).length;

// §2's three proofs, each with one real example from the same run.
const notes = (
  exhibit as unknown as { notes: Record<string, { id: string; value: string; quote?: string; label: string; sql?: string[] }> }
).notes;
const headline = notes[pipeline.change.pct.id];
const cause = Object.values(notes).find((n) => n.quote);
const metric = pipeline.metric;
// The metric's compiled SQL, two lines from the first SQL fact's recorded query (landing-data.ts exhibitData()).
const compiled = (exhibit as unknown as { compiled: { fact: string; lines: string[] } }).compiled;

const check = `<svg class="aa-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
const binaries = ["aa-linux-x64", "aa-linux-arm64", "aa-macos-arm64", "aa-windows-x64.exe", "SHA256SUMS"];
const doors = [
  {
    name: "CLI",
    does: "Analyze files, ask follow-ups, open the working behind any number.",
    cmd: "aa analyze ./exports --open",
    href: "use-it/cli/",
  },
  {
    name: "HTTP API",
    does: "Upload files, stream progress over SSE, fetch the report as JSON or HTML.",
    cmd: "aa serve",
    href: "use-it/http-api/",
  },
  {
    name: "MCP",
    does: "Claude Desktop, Cursor or any MCP client analyzes files and quotes verified numbers.",
    cmd: "aa mcp",
    href: "use-it/mcp/",
  },
  {
    name: "Telegram",
    does: "A demo bot: send files, get the summary and the report back.",
    cmd: "bun run --filter @agentic-analytics/telegram start",
    href: "use-it/telegram/",
  },
];
---

<BaseLayout title="agentic-analytics: an AI analyst you can audit">
  <StatusStrip slot="strip" items={evals.strip} />

  <div class="aa-paper">
    <section class="aa-sheet aa-hero" aria-labelledby="aa-hero-title">
      <div class="aa-cell aa-grid-field">
        <div class="aa-hero-grid">
          <div class="aa-hero-text">
            <h1 id="aa-hero-title" class="aa-display">An AI analyst you can audit.</h1>
            <p class="aa-lead">
              Give it your exports, PDFs and emails. Get what changed, why, and what to do next, with every number recomputed and every claim
              cited.
            </p>
            <div class="aa-actions">
              <a class="aa-button aa-button-primary" href={withBase("start/quickstart/")}>Quickstart</a>
              <a class="aa-button aa-button-secondary" href={withBase(DOCS_HOME)}>Read the docs</a>
              <a class="aa-text-link" href={GITHUB_URL}>GitHub</a>
            </div>
            <p class="aa-hero-cmd"><code>bun run aa analyze examples/coffee-roaster --open</code></p>
          </div>
          <Exhibit />
        </div>
      </div>
    </section>

    <section id="how" class="aa-sheet" aria-labelledby="aa-how-title">
      <div class="aa-cell aa-cell-head aa-grid-field">
        <SectionLabel n={1} text="How it works" />
        <h2 id="aa-how-title" class="aa-h2 aa-center">Files in, a verified and cited report out.</h2>
        <p class="aa-lead aa-center">
          The same run as the exhibit, stage by stage: read the files, define the metric, measure in SQL, find the cause in the documents,
          recompute every number, and only then write.
        </p>
      </div>
      <div class="aa-cell aa-how">
        <Pipeline client:visible />
      </div>
    </section>

    <section id="why" class="aa-sheet" aria-labelledby="aa-why-title">
      <div class="aa-cell aa-cell-head aa-grid-field">
        <SectionLabel n={2} text="Why it's different" />
        <h2 id="aa-why-title" class="aa-h2 aa-center">Built so you don't have to take its word for it.</h2>
      </div>
      <ul class="aa-proofs">
        <li class="aa-cell">
          <p class="aa-label">01 · Arithmetic</p>
          <h3 class="aa-h3">The model never does arithmetic</h3>
          <p>The model writes placeholders; every figure is a fact computed by SQL or a deterministic function, then recomputed.</p>
          {
            headline ? (
              <p class="aa-proof-example">
                <code>{`{{${headline.id}}}`}</code> <span aria-hidden="true">→</span> <span class="aa-fig">{headline.value}</span>
                <a class="aa-chip" href={`#fact-${headline.id}`} aria-label={`${headline.id}, verified`}>
                  <Fragment set:html={check} />
                  {headline.id}
                </a>
              </p>
            ) : null
          }
          <a class="aa-more" href={withBase("how-it-works/pipeline/")}>The pipeline</a>
        </li>
        <li class="aa-cell">
          <p class="aa-label">02 · Definitions</p>
          <h3 class="aa-h3">Definitions you confirm</h3>
          <p>Each metric is drafted in plain words and YAML before anything is measured. You accept, edit or drop it.</p>
          <p class="aa-proof-def">
            <code>{metric.id}</code>: {metric.formula}, per {metric.grain} · {metric.status} · compiles to
          </p>
          <pre class="aa-proof-code"><code>{compiled.lines.join("\n")}</code></pre>
          <a class="aa-more" href={withBase("how-it-works/metrics/")}>The metric layer</a>
        </li>
        <li class="aa-cell">
          <p class="aa-label">03 · Citations</p>
          <h3 class="aa-h3">Every claim is cited</h3>
          <p>Causes come from your documents, quoted exactly and checked against the source, and graded by how strong they are.</p>
          {
            cause ? (
              <p class="aa-proof-example">
                <q>{cause.quote}</q>{" "}
                <a class="aa-chip" href={`#source-${cause.id}`} aria-label={`${cause.id}, checked`}>
                  <Fragment set:html={check} />
                  {cause.id}
                </a>
                <span class="aa-proof-src">{cause.label}</span>
              </p>
            ) : null
          }
          <a class="aa-more" href={withBase("how-it-works/verifier/")}>The verifier</a>
        </li>
      </ul>
    </section>

    <section id="results" class="aa-sheet" aria-labelledby="aa-results-title">
      <div class="aa-cell aa-cell-head aa-grid-field">
        <SectionLabel n={3} text="Results, as they are" />
        <h2 id="aa-results-title" class="aa-h2 aa-center">Measured, with the caveats next to the numbers.</h2>
        <p class="aa-lead aa-center">
          Real public data first, checked against SQL written separately, then a real model on the smoke suite. The generated businesses
          with planted events run every night as the regression check; a pass the free tier cut short is labelled partial.
        </p>
      </div>
      <div class="aa-cell">
        <div class="aa-ledger-wrap" role="region" aria-label="Eval results" tabindex="0">
          <table class="aa-ledger aa-results">
            <thead>
              <tr>
                <th scope="col">Run</th>
                <th scope="col" class="num">Jobs</th>
                {
                  METRICS.map((m) => (
                    <th scope="col" class="num">
                      {m}
                      <span class="aa-th-sub">bar {bar(synthetic, m)?.bar}</span>
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <span class="aa-run">Real public data</span>
                  <span class="aa-run-note">
                    {evals.real.datasets.length} datasets, checked against SQL written separately · {evals.real.date}
                  </span>
                </td>
                <td class="num">
                  <span class="aa-fig">
                    {evals.real.datasets.filter((d) => d.completed).length}/{evals.real.datasets.length}
                  </span>
                </td>
                <td colspan={METRICS.length}>
                  <span class="aa-fig">
                    {realPassed}/{realChecks.length}
                  </span>{" "}
                  checks pass{realPassed === realChecks.length ? <Fragment set:html={` ${check}`} /> : null}
                </td>
              </tr>
              {
                rows.map((r) => {
                  const partial = r.suite.completed < r.suite.datasets;
                  return (
                    <tr>
                      <td>
                        <span class="aa-run">{r.run}</span>
                        <span class="aa-run-note">
                          {r.note} · {r.suite.date}
                        </span>
                      </td>
                      <td class="num">
                        <span class="aa-fig">
                          {r.suite.completed}/{r.suite.datasets}
                        </span>
                        {partial ? <span class="aa-partial">partial</span> : null}
                      </td>
                      {METRICS.map((m) => {
                        const b = bar(r.suite, m);
                        return (
                          <td class="num">
                            {partial ? (
                              <span class="aa-na">n/a (partial run)</span>
                            ) : (
                              <>
                                <span class="aa-fig">{show(b)}</span>{" "}
                                {b?.pass === true ? (
                                  <span class="aa-verified">
                                    <Fragment set:html={check} />
                                    <span class="aa-sr">meets the bar</span>
                                  </span>
                                ) : b?.pass === false ? (
                                  <span class="aa-below">below bar</span>
                                ) : null}
                              </>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  );
                })
              }

            </tbody>
          </table>
        </div>
        <p class="aa-small aa-under">
          The offline baseline is a scripted heuristic tuned on the same datasets, so its scores are optimistic: it tests the engine and the
          harness, not model quality. Sources: <code>{synthetic.file}</code>, <code>{smoke.file}</code>, <code>{full.file}</code>,{" "}
          <code>{evals.real.file}</code>. <a href={withBase("quality/results/")}>All results (RESULTS.md)</a> ·{" "}
          <a href={withBase("quality/evals/")}>How quality is measured</a>
        </p>
      </div>
    </section>

    <section id="quickstart" class="aa-sheet" aria-labelledby="aa-quick-title">
      <div class="aa-cell aa-cell-head aa-grid-field">
        <SectionLabel n={4} text="Quickstart" />
        <h2 id="aa-quick-title" class="aa-h2 aa-center">Run it on the example, then on your files.</h2>
      </div>
      <ol class="aa-steps">
        <li class="aa-cell">
          <p class="aa-label">Step 1 · Install</p>
          <div class="aa-code">
            <pre tabindex="0" aria-label="Install"><code>git clone https://github.com/gfirik/agentic-analytics
cd agentic-analytics
bun install
bun run aa doctor</code></pre>
          </div>
          <p class="aa-small">Node 22 and Bun. <code>doctor</code> says what this machine has.</p>
        </li>
        <li class="aa-cell">
          <p class="aa-label">Step 2 · Model</p>
          <div class="aa-code">
            <pre tabindex="0" aria-label="Choose a model"><code><span class="c"># local: Ollama, or a free endpoint in .env</span>
cp .env.example .env</code></pre>
          </div>
          <p class="aa-small">
            Free and local only: Ollama or a free OpenAI-compatible endpoint. <a href={withBase("models/running-free/")}>Running free</a>
          </p>
        </li>
        <li class="aa-cell">
          <p class="aa-label">Step 3 · Analyze</p>
          <div class="aa-code">
            <pre tabindex="0" aria-label="Analyze the example"><code>bun run aa analyze examples/coffee-roaster --open
<span class="c"># no model yet? replay it offline</span>
AA_DEMO_MODEL=scripted bun run aa analyze \
  examples/coffee-roaster --yes --embedder hash</code></pre>
          </div>
          <p class="aa-small">The report opens with every number linked to its working.</p>
        </li>
      </ol>
      <div class="aa-cell aa-quick-more">
        <div>
          <p class="aa-label">Standalone binaries · Docker</p>
          <p class="aa-small">
            No Node or Bun needed: attached to each tagged release, from v0.1.0 on, with a checksum file. <a href={RELEASES_URL}
              >Releases</a
            >
          </p>
          <ul class="aa-binaries">{binaries.map((b) => <li><code>{b}</code></li>)}</ul>
          <p class="aa-small"><code>docker compose up</code> · API, viewer and MCP on <code>http://127.0.0.1:8080</code></p>
        </div>
        <div>
          <p class="aa-label">Four doors, one engine</p>
          <ul class="aa-doors">
            {
              doors.map((d) => (
                <li>
                  <a class="aa-door-name" href={withBase(d.href)}>
                    {d.name}
                  </a>
                  <span class="aa-door-does">{d.does}</span>
                  <code class="aa-door-cmd">{d.cmd}</code>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The frame: one long vertical frame (1px rules left and right of the container), sections divided by full-width
     hairlines that meet it, a small + where they cross. Under 45rem the side rules would sit on the screen edge, so
     only the hairlines remain. */
  .aa-sheet {
    border-top: 1px solid var(--aa-rule);
  }
  .aa-sheet:first-child {
    border-top: 0;
  }
  .aa-cell {
    position: relative;
    max-width: var(--aa-container);
    margin: 0 auto;
    padding: var(--aa-space-8) var(--aa-gutter);
    border-inline: 1px solid var(--aa-rule);
  }
  .aa-cell + .aa-cell {
    border-top: 1px solid var(--aa-rule);
  }
  .aa-sheet {
    position: relative;
  }
  .aa-sheet::before,
  .aa-sheet::after {
    content: "+";
    position: absolute;
    top: -0.56rem;
    z-index: 2;
    font: 400 1rem / 1 var(--aa-font-mono);
    color: var(--aa-rule-strong);
    pointer-events: none;
  }
  .aa-sheet::before {
    left: calc(max(0px, (100% - var(--aa-container)) / 2) - 0.3rem);
  }
  .aa-sheet::after {
    right: calc(max(0px, (100% - var(--aa-container)) / 2) - 0.3rem);
  }
  .aa-sheet:first-child::before,
  .aa-sheet:first-child::after {
    content: none;
  }

  /* Graph paper behind the hero and the section heads only (decorative), fading to the plain page at the edges
     through a CSS mask. It sits under the content and never behind long text. */
  .aa-grid-field {
    isolation: isolate;
  }
  .aa-grid-field::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--aa-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--aa-grid) 1px, transparent 1px);
    background-size: var(--aa-grid-size) var(--aa-grid-size);
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 65% 70% at 50% 45%, #000 35%, transparent 100%);
    mask-image: radial-gradient(ellipse 65% 70% at 50% 45%, #000 35%, transparent 100%);
    pointer-events: none;
  }

  /* Hero: statement | exhibit | margin notes. */
  .aa-hero .aa-cell {
    padding-top: var(--aa-space-8);
    padding-bottom: var(--aa-space-7);
  }
  .aa-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) 17.5rem;
    gap: var(--aa-space-6);
    align-items: start;
  }
  .aa-hero-grid > :global(.aa-exhibit-wrap) {
    display: contents;
  }
  .aa-hero-text {
    display: grid;
    gap: var(--aa-space-5);
    padding-top: var(--aa-space-4);
  }
  .aa-hero-text .aa-lead {
    max-width: 34ch;
  }
  .aa-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--aa-space-3) var(--aa-space-4);
  }
  .aa-text-link {
    font: 500 0.9375rem / 1 var(--aa-font-sans);
  }
  .aa-hero-cmd code {
    font-size: 0.8125rem;
    color: var(--aa-ink-2);
    overflow-wrap: break-word;
  }
  @media (max-width: 68.75rem) {
    /* 900–1100px: the statement above, the exhibit and its notes side by side. */
    .aa-hero-grid {
      grid-template-columns: minmax(0, 1fr) 16rem;
    }
    .aa-hero-text {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .aa-hero-text .aa-lead {
      max-width: var(--aa-measure);
    }
  }
  @media (max-width: 56.24rem) {
    .aa-hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Section heads: the bracketed label on a hairline, a centred serif heading and lead. */
  .aa-cell-head {
    display: grid;
    justify-items: center;
    gap: var(--aa-space-4);
    padding-bottom: var(--aa-space-7);
    text-align: center;
  }
  .aa-center {
    margin-inline: auto;
  }

  /* §1 */
  .aa-how :global(.aa-island) {
    border: 0;
    padding: 0;
    background: transparent;
  }

  /* §2: three proof cells side by side, divided by hairlines. */
  .aa-proofs {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--aa-container);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-inline: 1px solid var(--aa-rule);
    border-top: 1px solid var(--aa-rule);
  }
  .aa-proofs > .aa-cell {
    display: grid;
    grid-template-rows: auto auto auto auto 1fr auto;
    gap: var(--aa-space-3);
    margin: 0;
    padding: var(--aa-space-6) var(--aa-space-5);
    border: 0;
  }
  .aa-proofs > .aa-cell + .aa-cell {
    border-top: 0;
    border-left: 1px solid var(--aa-rule);
  }
  .aa-proofs p:not(.aa-label) {
    color: var(--aa-ink-2);
    font-size: var(--aa-text-small);
  }
  .aa-proof-example {
    align-self: start;
    padding: var(--aa-space-3);
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
    background: var(--aa-raised);
  }
  .aa-proofs .aa-proof-example {
    color: var(--aa-ink);
  }
  .aa-proof-example code {
    font-size: 0.8125rem;
  }
  .aa-proof-src {
    display: block;
    margin-top: var(--aa-space-1);
    font: 400 0.75rem / 1.4 var(--aa-font-mono);
    color: var(--aa-ink-3);
  }
  .aa-proofs .aa-proof-def {
    color: var(--aa-ink);
    font-size: 0.8125rem;
  }
  .aa-proof-code {
    align-self: start;
    margin: 0;
    padding: var(--aa-space-3);
    border: 1px solid var(--aa-rule);
    border-radius: var(--aa-radius);
    background: var(--aa-raised);
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .aa-more {
    justify-self: start;
    font-weight: 500;
    font-size: var(--aa-text-small);
  }
  .aa-more::after {
    content: " →";
  }
  @media (max-width: 52rem) {
    .aa-proofs {
      grid-template-columns: minmax(0, 1fr);
    }
    .aa-proofs > .aa-cell + .aa-cell {
      border-left: 0;
      border-top: 1px solid var(--aa-rule);
    }
  }

  /* §3 */
  .aa-results th.num,
  .aa-results td.num {
    text-align: right;
  }
  .aa-th-sub {
    display: block;
    margin-top: 0.15rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .aa-run {
    display: block;
    font-weight: 500;
  }
  .aa-run-note {
    display: block;
    font-size: 0.8125rem;
    color: var(--aa-ink-2);
    min-width: 13rem;
  }
  .aa-partial {
    display: block;
    font: 500 var(--aa-text-label) / 1.4 var(--aa-font-mono);
    letter-spacing: var(--aa-label-tracking);
    text-transform: uppercase;
    color: var(--aa-ink);
  }
  .aa-na {
    font-size: 0.8125rem;
    color: var(--aa-ink-2);
    white-space: nowrap;
  }
  .aa-below {
    font-family: var(--aa-font-mono);
    font-size: 0.75rem;
    color: var(--aa-ink);
    border-bottom: 1px solid var(--aa-ink);
    white-space: nowrap;
  }
  .aa-under {
    margin-top: var(--aa-space-5);
    max-width: 72ch;
  }

  /* §4 */
  .aa-steps {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--aa-container);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-inline: 1px solid var(--aa-rule);
    border-top: 1px solid var(--aa-rule);
  }
  .aa-steps > .aa-cell {
    display: grid;
    align-content: start;
    gap: var(--aa-space-3);
    margin: 0;
    padding: var(--aa-space-6) var(--aa-space-5);
    border: 0;
  }
