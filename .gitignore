node_modules/
dist/
.turbo/
coverage/
.env
.env.*
!.env.example
# Editor swap and backup files (a swap of .env holds its keys)
*.swp
*.swo
*~
data/
*.duckdb
*.duckdb.wal
.DS_Store
# Baseline smoke runs are local; full-suite and real-model results are published (RESULTS.md is rebuilt from them)
evals/results/*-baseline-smoke.json
# an unreadable earlier results file set aside by aa eval --passes (docs/EVALS.md §3)
evals/results/*.bad
# --repeat on the scripted baseline: local, like baseline smoke runs (docs/specs/accuracy.md §7)
evals/results/repeat/*-baseline-smoke-repeat*
# --model baseline ablation runs: canned answers, a harness check (docs/specs/accuracy.md §8.5)
evals/results/ablation/*-baseline-*
!evals/results/.gitkeep
.autopilot/
packages/report/out/

# Generated eval datasets: files are rebuilt from the seeded generator; answer keys are versioned
evals/datasets/generated/*/files/
evals/datasets/heldout/*/files/
# Docs site: generated by apps/docs/scripts/generate.ts on every build
apps/docs/src/data/
apps/docs/public/openapi.json
apps/docs/src/content/docs/use-it/http-api.md
apps/docs/src/content/docs/reference/report-schema.md
apps/docs/src/content/docs/quality/results.md
apps/docs/src/content/docs/project/decisions.md
apps/docs/src/content/docs/project/roadmap.md
apps/docs/src/content/docs/project/changelog.md
apps/docs/.astro/
# Playwright run output
test-results/
playwright-report/
# Model response cache (M13a): eval reruns are served from here
evals/.cache/
# Agent worktrees (Claude Code): separate checkouts, never linted or committed from here
.claude/worktrees/
# Standalone binary build (scripts/build-binary.ts)
apps/cli/native/
# Reports and eval results the Learn tutorials write when run from a clone's root (aa analyze, aa eval --answers)
/agentic-analytics/
/eval-results/
