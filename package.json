{
  "name": "agentic-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "apps/*",
    "evals/*",
    "fixtures"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check . && turbo run typecheck && tsc --noEmit -p scripts/tsconfig.json && vitest run && bun run schema:drift && bun run readme:check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:drift": "tsx scripts/schema-drift.ts",
    "schema:write": "tsx scripts/schema-drift.ts --write",
    "aa": "node apps/cli/bin/aa.js",
    "ingest": "tsx packages/ingest/scripts/demo.ts",
    "profile": "tsx packages/profile/scripts/demo.ts",
    "analyze": "tsx packages/analysis/scripts/demo.ts",
    "eval": "node apps/cli/bin/aa.js eval",
    "readme:assets": "tsx scripts/readme-assets/assets.ts --write",
    "readme:check": "tsx scripts/readme-assets/assets.ts --check",
    "readme:check:browser": "playwright test -c scripts/readme-assets/playwright.config.ts",
    "readme:pipeline": "tsx apps/docs/scripts/pipeline-data.ts --write && node --import tsx scripts/readme-assets/pipeline-gif.ts"
  },
  "devDependencies": {
    "@agentic-analytics/eval-datasets": "workspace:*",
    "@agentic-analytics/schema": "workspace:*",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
